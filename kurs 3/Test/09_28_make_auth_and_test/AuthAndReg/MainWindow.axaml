<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
        Width="300" Height="500"
        x:Class="AuthAndReg.MainWindow"
        Icon="icon.ico"
        WindowStartupLocation="CenterOwner"
        Title="Вход в аккаунт"
        CanResize="False"
        Background="AliceBlue"
        >

    <StackPanel HorizontalAlignment="Center" Margin="50">
        <Label Content="ЭлектроникоShop" FontSize="20" FontWeight="Bold" Foreground="Blue" />
        <Border CornerRadius="30" Background="AliceBlue">
            <Image Source="icon.ico"/>
        </Border>
        <Label Content="Вход" FontSize="15" FontWeight="Bold" />
        <TextBlock Text="Электронная почта"/>
        <TextBox x:Name="EmailBox"  MaxLength="25" />
        <TextBlock Text="Пароль"/>
        <TextBox x:Name="PasswordBox" MaxLength="15" />
        <Button Content="Войти" Click="Button_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0 10" />
        <TextBlock x:Name="MessageText" Foreground="Red"/>
        <Button Content="Зарегистрироватся" FontSize="20" Background="Transparent" Click="Button_Click_To_Reg" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Content="Забыл пароль" FontSize="20" Background="Transparent" Click="Button_Click_Code" Foreground="Blue"  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
    </StackPanel>
</Window>
