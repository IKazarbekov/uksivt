<Window x:Class="Work_Doc_Моё_решение.WorkerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Work_Doc_Моё_решение"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="MainWindow" Height="800" Width="1300" AllowsTransparency="True" WindowStyle="None" MouseDown="Window_MouseDown">
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal">
            <Label Content="Заявка"/>
            <Button Content="X" Margin="100 0 0 0" Background="Transparent" BorderBrush="Transparent" Click="Button_Click_2"/>
        </StackPanel>
        <TextBlock x:Name="name"/>
        <TextBlock Text="Описание"/>
        <RichTextBox x:Name="describe" FontSize="25" TextChanged="describe_TextChanged"/>
        <TextBlock Text="Кабинет"/>
        <TextBox x:Name="room" TextChanged="room_TextChanged"/>
        <DatePicker x:Name="date" FontSize="30"/>
        <ListView x:Name="list" Height="180" FontSize="5">
            
        </ListView>
        <Button Content="Отправить" x:Name="button" Click="button_Click" IsEnabled="False"/>
        <Button Content="Выйти" Click="Button_Click_1" Background="Transparent" BorderBrush="Transparent" Foreground="Red"/>
    </StackPanel>
</Window>
