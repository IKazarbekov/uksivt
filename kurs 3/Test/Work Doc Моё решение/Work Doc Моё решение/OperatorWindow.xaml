<Window x:Class="Work_Doc_Моё_решение.OperatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Work_Doc_Моё_решение"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="MainWindow" Height="480" Width="900" AllowsTransparency="True" WindowStyle="None" MouseDown="Window_MouseDown">
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal">
            <Label Content="Заявки сотрудников"/>
            <Button Content="X" Margin="480 0 0 0" Background="Transparent" BorderBrush="Transparent" Click="Button_Click_2"/>
        </StackPanel>
        <ListView Height="200" x:Name="list" MouseDown="list_Selected" FontSize="15"/>
        <Button Content="Принять" x:Name="button" Click="button_Click_1" IsEnabled="False"/>
        <Button Content="Выйти" Background="Transparent" BorderBrush="Transparent" Foreground="Red" Click="Button_Click"/>
    </StackPanel>
</Window>
