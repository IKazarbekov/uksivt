<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="95dp"
                android:layout_marginRight="52dp"
                android:minHeight="205dp"
                android:minWidth="323dp"
                android:src="@mipmap/image_enter"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome"
                android:layout_marginHorizontal="52dp"
                android:layout_marginTop="42dp"
                android:textSize="70px"
                android:textColor="@color/pink"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/continue_login"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="52dp"
                android:textSize="40px"

                android:textColor="@color/black"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:textColorHint="@color/black"
                android:minHeight="48dp"
                android:searchResultHighlightColor="@color/white"
                android:backgroundTint="@color/pink"
                android:layout_marginTop="40dp"
                android:layout_marginHorizontal="52dp"/>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:textColorHint="@color/black"
                android:minHeight="48dp"
                android:searchResultHighlightColor="@color/white"
                android:backgroundTint="@color/pink"
                android:layout_marginHorizontal="52dp"
                android:layout_marginTop="24dp"
                />

            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/forgot"
                android:layout_marginHorizontal="52dp"
                android:textAlignment="textEnd"
                />

            <Button
                android:id="@+id/bLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/pink"
                android:text="@string/lets"
                android:textSize="20dp"
                android:height="70dp"
                android:layout_marginTop="30dp"
                android:layout_marginLeft="76dp"
                android:layout_marginRight="77dp"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/connect"
                android:textColor="@color/pink"
                android:layout_marginHorizontal="52dp"
                android:layout_marginTop="23dp"
                android:textAlignment="center"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="52px">

                <Button
                    android:id="@+id/bGoogle"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:backgroundTint="@color/red"
                    android:text="G"
                    android:textSize="20dp"
                    />
                <Button
                    android:id="@+id/bF"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="f"
                    android:backgroundTint="@color/blue"
                    android:textSize="80px"
                    />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/not_account"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="52dp"
                android:textAlignment="center"
                />

            <TextView
                android:id="@+id/tvCreateAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/create_account"
                android:textColor="@color/pink"
                android:layout_marginHorizontal="52dp"
                android:textAlignment="center"
                />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>