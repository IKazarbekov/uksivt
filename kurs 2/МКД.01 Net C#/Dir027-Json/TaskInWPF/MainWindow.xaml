<Window x:Class="TaskInWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskInWPF"
        mc:Ignorable="d"
Title="Игровая платформа" Height="700" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Список игр" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" Name="dgGames" AutoGenerateColumns="False" IsReadOnly="True" 
                  SelectionChanged="dgGames_SelectionChanged" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="120"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="180"/>
                <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating}" Width="60"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding DisplayPrice}" Width="80"/>
                <DataGridTextColumn Header="Возраст" Binding="{Binding AgeRestriction}" Width="70"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="100"/>
                <DataGridTemplateColumn Header="Обложка" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding CoverImagePath}" Width="80" Height="80" Stretch="Uniform"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Добавление / Редактирование" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Название:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="txtTitle" Margin="0,3"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Описание:" VerticalAlignment="Top"/>
                <TextBox Grid.Row="2" Grid.Column="1" Name="txtDescription" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,3"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Рейтинг (0-10):" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Name="txtRating" Margin="0,3"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Цена:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <CheckBox Name="chkIsFree" Content="Бесплатно" VerticalAlignment="Center" Margin="0,0,10,0" Checked="chkIsFree_Checked" Unchecked="chkIsFree_Checked"/>
                    <TextBox Name="txtPrice" Width="120" IsEnabled="True"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Возраст (+):" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="1" Name="txtAge" Margin="0,3"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Жанр:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="6" Grid.Column="1" Name="txtGenre" Margin="0,3"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Обложка:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Name="txtCoverPath" Width="200" Margin="0,0,5,0"/>
                    <Button Name="btnBrowse" Content="..." Width="30" Click="btnBrowse_Click"/>
                </StackPanel>
                <Image Name="imgPreview" Grid.Row="8" Grid.ColumnSpan="2" Width="100" Height="100" Stretch="Uniform" Margin="0,5"/>

                <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
                    <Button Name="btnAddUpdate" Content="Добавить" Width="100" Height="30" Margin="5" Click="btnAddUpdate_Click"/>
                    <Button Name="btnCancel" Content="Отменить" Width="100" Height="30" Margin="5" Click="btnCancel_Click"/>
                    <Button Name="btnDelete" Content="Удалить" Width="100" Height="30" Margin="5" Click="btnDelete_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
