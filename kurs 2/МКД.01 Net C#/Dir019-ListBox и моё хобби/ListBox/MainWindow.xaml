<Window x:Class="ListBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ListBox"
        mc:Ignorable="d"
        Title="Магазин микроконтроллеров arduino" Height="450" Width="400"
        Icon="/images/icon.png"
        >
    <Window.Background>
        <ImageBrush x:Name="imageBrush" ImageSource="/images/fon.jpeg"/>
    </Window.Background>
    <DockPanel Margin="20" LastChildFill="True">
        <Border CornerRadius="20"
                DockPanel.Dock="Top"
                Background="Green"
                Margin="10">
            
            <Label Content="Сборник электроники"
                   Grid.Row="0"
               FontSize="20"
               Foreground="AliceBlue"
                   FontFamily="Bahnschrift"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
               />
        </Border>

        <UniformGrid Columns="3"
                     DockPanel.Dock="Bottom">
            <Button Content="добавить" Click="Button_Click"
                    Margin="10 10 0 10"
                    FontFamily="Bahnschrift"
                    FontSize="20">
                <Button.Background>
                    <LinearGradientBrush>
                        <GradientStop Color="LightGreen" Offset="0"/>
                        <GradientStop Color="AliceBlue" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <TextBox x:Name="textBox"
                     Margin="0 10 10 10"
                     FontSize="20"/>
            <Button Content="Удалить" 
                    Click="Button_Click_1"
                    Margin="10"
                    FontFamily="Bahnschrift"
                    FontSize="20"
                    >
                <Button.Background>
                    <LinearGradientBrush>
                        <GradientStop Color="PaleVioletRed" Offset="0"/>
                        <GradientStop Color="Red" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </UniformGrid>
        <ListBox 
                 x:Name="listBox"
                 Margin="10"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <WrapPanel Margin="10"
                               >
                        <Image Source="{Binding PathImage}"
                               MaxHeight="100"
                               MaxWidth="100"/>
                        <Border CornerRadius="50"
                                Background="Blue">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="40"
                                   Foreground="White"
                                   />
                        </Border>
                    </WrapPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
