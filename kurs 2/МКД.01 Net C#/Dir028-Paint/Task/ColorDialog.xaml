<Window x:Class="Task.ColorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task"
        mc:Ignorable="d"
        Title="ColorDialog" Height="250" Width="400">
    <StackPanel Width="300" Margin="20">
        <!-- Добавляем ValueChanged для каждого слайдера -->
        <TextBlock Text="Red"/>
        <Slider Name="SliderR" Minimum="0" Maximum="255" Value="128" ValueChanged="Slider_ValueChanged"/>
        <TextBlock Text="Green"/>
        <Slider Name="SliderG" Minimum="0" Maximum="255" Value="128" ValueChanged="Slider_ValueChanged"/>
        <TextBlock Text="Blue"/>
        <Slider Name="SliderB" Minimum="0" Maximum="255" Value="128" ValueChanged="Slider_ValueChanged"/>

        <!-- Даем имя нашей кисти Inside Rectangle -->
        <Rectangle Height="50" Margin="0,10,0,0">
            <Rectangle.Fill>
                <SolidColorBrush x:Name="MyResultBrush" Color="Gray"/>
            </Rectangle.Fill>
        </Rectangle>
        <Separator Height="1"/>
        <Button Content="Готово" Height="30" FontSize="15" Click="Button_Click"/>
    </StackPanel>


</Window>
