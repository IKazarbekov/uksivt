<Window x:Class="ЛАБ_5_Задание_2___лаб_3_со_стилями.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ЛАБ_5_Задание_2___лаб_3_со_стилями"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Background" Value="Yellow"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontFamily" Value="Cambria"/>
            <Setter Property="Foreground" Value="Wheat"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="Orange"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontFamily" Value="Cambria"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1 10 1 5"/>
            <Setter Property="Background" Value="Gray"/>
        </Style>
    </Window.Resources>
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top" Height="15">

        </Menu>
        <StackPanel DockPanel.Dock="Left" Orientation="Vertical" Width="100" Background="Gray">
            <Label Content="Инструменты" Foreground="White"/>
            <RadioButton x:Name="RadioButtonInk" GroupName="Tool" Content="Кисть" Click="ChangeTool"/>
            <RadioButton x:Name="RadioButtonSelect" GroupName="Tool" Content="Выделитель" Click="ChangeTool"/>
            <RadioButton x:Name="RadioButtonErase" GroupName="Tool" Content="Ластик" Click="ChangeTool"/>
            <Separator/>
            <Label Content="Кисть" Foreground="White"/>
            <ComboBox x:Name="ComboBoxColor" SelectedIndex="0" MouseLeave="ChangeColor">
                <ComboBoxItem Content="Красный"/>
                <ComboBoxItem Content="Зелёный"/>
                <ComboBoxItem Content="Синий"/>
                <ComboBoxItem Content="Серый"/>
                <ComboBoxItem Content="Белый"/>
                <ComboBoxItem Content="Чёрный"/>
                <ComboBoxItem Content="Жёлтый"/>
                <ComboBoxItem Content="Оранжевый"/>
            </ComboBox>
            <Slider x:Name="SliderSize" Minimum="5" Maximum="100" Value="20" MouseLeave="ChangeSize"/>
        </StackPanel>
        <StatusBar DockPanel.Dock="Bottom" Height="20">

        </StatusBar>
        <InkCanvas x:Name="InkCanvasMain" EditingMode="Ink">
            <InkCanvas.DefaultDrawingAttributes>
                <DrawingAttributes x:Name="DrawingAttr" Color="RED" Height="10" Width="10"/>
            </InkCanvas.DefaultDrawingAttributes>
        </InkCanvas>
    </DockPanel>
</Window>
