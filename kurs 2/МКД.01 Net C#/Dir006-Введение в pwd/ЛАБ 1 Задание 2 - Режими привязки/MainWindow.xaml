<Window x:Class="ЛАБ_1_Задание_2___Режими_привязки.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ЛАБ_1_Задание_2___Режими_привязки"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <TextBox x:Name="t1" Height="50" />
        <TextBox x:Name="t2" Text="{Binding ElementName=t1, Path=Text, Mode=OneWay}" Height="50" />
        <Slider Maximum="200" Minimum="50" x:Name="slider1" Height="50" />
        <Slider Maximum="200" Minimum="50" x:Name="slider2" Value="{Binding ElementName=slider1, Path=Value, Mode=OneWayToSource}" Height="0" />
        <Label Content="Font Size" FontSize="20"/>
        <TextBox x:Name="TextBoxSize" Text="{Binding ElementName=slider1, Path=Value, Mode=TwoWay}" Height="200" FontSize="{Binding ElementName=TextBoxSize, Path=Text}"/>
    </StackPanel>
</Window>
