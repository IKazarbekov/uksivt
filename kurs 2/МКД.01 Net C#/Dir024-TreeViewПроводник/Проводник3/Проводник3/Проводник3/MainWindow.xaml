<Window x:Class="Проводник3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проводник" Height="600" Width="900"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <ContextMenu x:Key="FolderContextMenu">
            <MenuItem Header="Открыть" Click="MenuItem_Open_Click"/>
            <MenuItem Header="Свойства" Click="MenuItem_Properties_Click"/>
        </ContextMenu>

        <ContextMenu x:Key="FileContextMenu">
            <MenuItem Header="Открыть" Click="MenuItem_Open_Click"/>
            <MenuItem Header="Копировать путь" Click="MenuItem_CopyPath_Click"/>
            <Separator/>
            <MenuItem Header="Свойства" Click="MenuItem_Properties_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Навигационная панель -->
        <ToolBar Grid.Row="0" Margin="2">
            <Button x:Name="BtnBack" Content="◀ Назад" Click="BtnBack_Click" Margin="2"/>
            <Button x:Name="BtnForward" Content="Вперёд ▶" Click="BtnForward_Click" Margin="2"/>
            <Button x:Name="BtnUp" Content="⬆ Вверх" Click="BtnUp_Click" Margin="2"/>
            <Button x:Name="BtnRefresh" Content="🔄 Обновить" Click="BtnRefresh_Click" Margin="2"/>
        </ToolBar>

        <!-- 2. Вкладки -->
        <TabControl Grid.Row="1">
            <TabItem Header="Главная">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5">
                    <Button Margin="2" ToolTip="Копировать" Click="InMainMenu_Copy_Click">
                        <StackPanel>
                            <TextBlock Text="📄" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Копировать" FontSize="8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="2" ToolTip="Вставить" Click="InMainMenu_Paste_Click">
                        <StackPanel>
                            <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Вставить" FontSize="8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="2" ToolTip="Вырезать" Click="InMainMenu_Cut_Click">
                        <StackPanel>
                            <TextBlock Text="✂️" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Вырезать" FontSize="8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="2" ToolTip="Скопировать путь" Click="InMainMenu_CopyPath_Click">
                        <StackPanel>
                            <TextBlock Text="📎" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Копировать путь" FontSize="8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

                    <Button Margin="2" ToolTip="Переместить в" Click="InMainMenu_MoveTo_Click">
                        <StackPanel>
                            <TextBlock Text="📁" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Переместить в" FontSize="8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="2" ToolTip="Копировать в" Click="InMainMenu_CopyTo_Click">
                        <StackPanel>
                            <TextBlock Text="📁" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Копировать в" FontSize="8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="2" ToolTip="Удалить" Click="InMainMenu_Delete_Click">
                        <StackPanel>
                            <TextBlock Text="🗑️" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Удалить" FontSize="8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="2" ToolTip="Переименовать" Click="InMainMenu_Rename_Click">
                        <StackPanel>
                            <TextBlock Text="✏️" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Переименовать" FontSize="8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

                    <Button Margin="2" ToolTip="Новая папка" Click="InMainMenu_NewFolder_Click">
                        <StackPanel>
                            <TextBlock Text="🆕" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Новая папка" FontSize="8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="2" ToolTip="Новый файл" Click="InMainMenu_NewFile_Click">
                        <StackPanel>
                            <TextBlock Text="📝" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Новый файл" FontSize="8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="2" ToolTip="Свойства" Click="InMainMenu_Properties_Click">
                        <StackPanel>
                            <TextBlock Text="⚙️" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Свойства" FontSize="8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </TabItem>
            <TabItem Header="Вид">
                <StackPanel Orientation="Horizontal" Margin="5" VerticalAlignment="Center">
                    <TextBlock Text="Режим: " VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="ViewModeBox" SelectedIndex="0">
                        <ComboBoxItem Content="Таблица"/>
                        <ComboBoxItem Content="Список"/>
                    </ComboBox>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- 3. Основная область -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="TreeViewFolders"
                      SelectedItemChanged="TreeViewFolders_SelectedItemChanged"
                      TreeViewItem.Expanded="TreeViewItem_Expanded"
                      ContextMenu="{StaticResource FolderContextMenu}">
                <TreeViewItem Header="Быстрый доступ" Tag="" IsExpanded="True">
                    <TreeViewItem Header="Рабочий стол" Tag="Desktop"/>
                    <TreeViewItem Header="Документы"   Tag="Documents"/>
                    <TreeViewItem Header="Загрузки"    Tag="Downloads"/>
                    <TreeViewItem Header="Музыка"      Tag="Music"/>
                    <TreeViewItem Header="Изображения" Tag="Pictures"/>
                    <TreeViewItem Header="Видео"       Tag="Videos"/>
                </TreeViewItem>
                <TreeViewItem x:Name="ThisPCNode" Header="Этот компьютер" Tag="" IsExpanded="False"/>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <DataGrid x:Name="ListViewFiles" Grid.Column="2"
                      SelectionChanged="ListViewFiles_SelectionChanged"
                      MouseDoubleClick="ListViewFiles_MouseDoubleClick"
                      ContextMenu="{StaticResource FileContextMenu}"
                      AutoGenerateColumns="False"
                      Background="Transparent"
                      IsReadOnly="True"
                      CanUserDeleteRows="False"
                      CanUserAddRows="False"
                      CanUserResizeColumns="True"
                      CanUserResizeRows="True">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="#4CA0A0A0"/>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Имя" Width="200">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Дата изменения" Width="150"
                                        Binding="{Binding Modified}"/>
                    <DataGridTextColumn Header="Тип" Width="100"
                                        Binding="{Binding Type}"/>
                    <DataGridTextColumn Header="Размер" Width="100"
                                        Binding="{Binding Size}"/>
                </DataGrid.Columns>

                </DataGrid>
        </Grid>

        <TextBox x:Name="TxtPath" Grid.Row="3" Height="25" Margin="5"
                 Text="Выделите файл или папку..." IsReadOnly="True"/>
    </Grid>
</Window>