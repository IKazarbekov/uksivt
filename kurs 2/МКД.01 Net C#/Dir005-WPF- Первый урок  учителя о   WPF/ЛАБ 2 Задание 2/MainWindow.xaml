<Window x:Class="ЛАБ_2_Задание_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ЛАБ_2_Задание_2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <WrapPanel Margin="0, 100, 0, 0">
            <Button Content="A" Background="Yellow" Height="74" Width="66" Margin="30, 30, 30, 30"></Button>
            <Button Content="B" Background="Red" Height="74" Width="66" Margin="30, 30, 30, 30"></Button>
            <Button Content="C" Background="Green" Height="74" Width="66" Margin="30, 30, 30, 30"></Button>
            <Button Content="D" Background="Blue" Height="74" Width="66" Margin="30, 30, 30, 30"></Button>
            <Button Content="E" Background="Gray" Height="74" Width="66" Margin="30, 30, 30, 30"></Button>
            <Button Content="F" Background="#FFCECECE" Height="74" Width="66" Margin="30, 30, 30, 30"></Button>
        </WrapPanel>

        <WrapPanel Grid.Column="1">
            <Button Content="A" Background="Yellow" Height="74" Width="66" Margin="30, 30, 30, 30"></Button>
            <Button Content="B" Background="Red" Height="74" Width="66" Margin="30, 30, 30, 30"></Button>
            <Button Content="C" Background="Green" Height="74" Width="66" Margin="30, 30, 30, 30"></Button>
            <Button Content="D" Background="Blue" Height="74" Width="66" Margin="30, 30, 30, 30"></Button>
            <Button Content="E" Background="Gray" Height="74" Width="66" Margin="30, 30, 30, 30"></Button>
            <Button Content="F" Background="#FFCECECE" Height="74" Width="66" Margin="30, 30, 30, 30"></Button>
        </WrapPanel>
    </Grid>
</Window>
