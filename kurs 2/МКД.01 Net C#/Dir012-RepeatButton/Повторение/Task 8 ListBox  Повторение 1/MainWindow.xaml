<Window x:Class="Task_8_ListBox__Повторение_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_8_ListBox__Повторение_1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="500">

    <Window.Resources>
        <CollectionViewSource x:Name="collectionViewSource" x:Key="colViewSource" Source="{Binding}">
            
        </CollectionViewSource>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.6*"/>
        </Grid.ColumnDefinitions>
        <ListView Grid.Column="0" ItemsSource="{Binding Source={StaticResource colViewSource}}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Width="200"/>
                        <Border CornerRadius="15" Background="LightBlue" Padding="20">
                            <TextBlock Foreground="LightGreen" Text="{Binding Price}" Width="50"/>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <UniformGrid Columns="4" Grid.Column="1">
            <CheckBox Content="Electronic" FontSize="20" Unchecked="CheckBox_Checked" Checked="CheckBox_Checked"/>
        </UniformGrid>
    </Grid>
</Window>
