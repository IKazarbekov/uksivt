<Window x:Class="Task1___повтор_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task1___повтор_2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel LastChildFill="True">
        <UniformGrid DockPanel.Dock="Bottom" Height="50" Rows="1">
            <Button Content="create" Click="Button_Click"/>
            <Button Content="remove" Click="Button_Click_1"/>
        </UniformGrid>
        <DataGrid x:Name="DataGridEmployees"
                  CanUserAddRows="True"
                  CanUserSortColumns="True"
                  AutoGenerateColumns="True"
                  CellEditEnding="DataGridEmployees_CellEditEnding"/>
    </DockPanel>
</Window>
