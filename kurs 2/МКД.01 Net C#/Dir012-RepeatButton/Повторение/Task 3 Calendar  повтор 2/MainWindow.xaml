<Window x:Class="Task_3_Calendar__повтор_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_3_Calendar__повтор_2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <DockPanel DockPanel.Dock="Left">
            <Calendar x:Name="calendar" DockPanel.Dock="Top" SelectedDatesChanged="calendar_SelectedDatesChanged" SelectionMode="MultipleRange"/>
            <Button Content="Добавить задачу" DockPanel.Dock="Bottom" Click="Button_Click_1"/>
            <Button Content="Показать все задачи" DockPanel.Dock="Bottom" Click="Button_Click"/>
        </DockPanel>
        <ListBox x:Name="listBoxTasks" DockPanel.Dock="Right">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox Content="выполнен" IsChecked="{Binding IsCompleted}"/>
                        <TextBlock Text="{Binding Description}"/>
                        <TextBlock Text="{Binding Date}"/>
                    </WrapPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
