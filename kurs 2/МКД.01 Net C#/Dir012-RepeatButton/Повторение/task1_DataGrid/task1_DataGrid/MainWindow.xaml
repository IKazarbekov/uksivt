<Window x:Class="task1_DataGrid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:task1_DataGrid"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Closed="Window_Closed">
    <DockPanel>
        <UniformGrid DockPanel.Dock="Bottom" Rows="1" Height="50">
            <Button Content="Взять сотрудника" FontSize="20" Click="Button_Click_Add"/>
            <Button Content="Уволить сотрудника" FontSize="20" Click="Button_Click_Remove"/>
        </UniformGrid>
        <DataGrid x:Name="DataGridEmployees"
            AutoGenerateColumns="True"
            CanUserAddRows="True"
            CanUserSortColumns="True"
            IsReadOnly="False"
            FontSize="30"
            CellEditEnding="DataGridEmployees_CellEditEnding"
           />
    </DockPanel>
</Window>
