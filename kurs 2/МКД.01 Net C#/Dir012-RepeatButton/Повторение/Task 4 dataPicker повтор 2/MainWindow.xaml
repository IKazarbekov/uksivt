<Window x:Class="Task_4_dataPicker_повтор_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_4_dataPicker_повтор_2"
        mc:Ignorable="d"
        Title="MainWindow" Height="260" Width="300">
    <DockPanel LastChildFill="True">
        <StackPanel Margin="10">
            <TextBlock Text="Дешёвая гостиница"/>
            <Separator Height="10"/>
            <TextBlock Text="Первый день"/>
            <DatePicker x:Name="datePickerStart"/>
            <Separator Height="10"/>
            <TextBlock Text="Второй день"/>
            <DatePicker x:Name="datePickerEnd"/>
            <Separator Height="10"/>
            <CheckBox x:Name="checkBox" Content="Завтрак"/>
            <Separator Height="10"/>
            <Button Content="Забронировать" Click="Button_Click"/>
        </StackPanel>
    </DockPanel>

</Window>
