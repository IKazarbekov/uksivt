<Window x:Class="Task3_Calendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task3_Calendar"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel LastChildFill="True">
        <DockPanel>
            <Calendar x:Name="calendar" DockPanel.Dock="Top" SelectedDatesChanged="Calendar_SelectedDatesChanged" SelectionMode="MultipleRange">
                <Calendar.CalendarDayButtonStyle>
                    <Style TargetType="CalendarDayButton">
                        <Setter Property="Background" Value="Green"/>
                        <Setter Property="Margin" Value="5"/>
                        <Setter Property="Foreground" Value="Blue"/>
                    </Style>
                </Calendar.CalendarDayButtonStyle>
            </Calendar>
            <Button  DockPanel.Dock="Bottom" Content="Добавить" Click="Button_Click" Height="100" FontSize="30" FontWeight="Bold" />
            <Button  DockPanel.Dock="Bottom" Content="Все задачи" Click="Button_Click_1" FontSize="30" FontWeight="Bold"/>
        </DockPanel>
        <ListBox x:Name="listBoxTasks">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <WrapPanel>
                        <TextBlock Text="{Binding Date}"/>
                        <CheckBox IsChecked="{Binding IsCompleted}" Width="100" Content="Выполнено"/>
                        <TextBlock Text="{Binding Description}"/>
                    </WrapPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
