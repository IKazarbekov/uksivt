<Window x:Class="Task3_Calendar.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task3_Calendar"
        mc:Ignorable="d"
        Title="InputWindow" Height="400" Width="200">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Создание задачи" FontSize="25"/>
        <Calendar x:Name="calendar" DockPanel.Dock="Top" SelectionMode="SingleDate"/>
        <Button Content="Создать" DockPanel.Dock="Bottom" Height="30" Margin="10" Click="Button_Click"/>
        <TextBox x:Name="textBox" DockPanel.Dock="Bottom" Margin="10" Text="Описание"/>
    </DockPanel>
</Window>
