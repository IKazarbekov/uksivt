<Window x:Class="Task_6_All.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_6_All"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="400
        ">
    <UniformGrid Columns="2" Rows="6">
        <TextBlock Text="Имя" FontSize="20" TextAlignment="Right" Margin="20"/>
        <TextBox x:Name="textBoxName" FontSize="20" TextAlignment="Left"/>
        <TextBlock Text="Пол Мужской" FontSize="20" TextAlignment="Right" Margin="20"/>
        <CheckBox x:Name="radioButtonPol" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        <TextBlock Text="Хобби" FontSize="20" TextAlignment="Right" Margin="20"/>
        <UniformGrid Columns="2" Rows="2">
            <RadioButton IsChecked="True" x:Name="checkBoxSport" HorizontalAlignment="Center" VerticalAlignment="Bottom" Content="Спорт"/>
            <RadioButton x:Name="checkBoxMusic" HorizontalAlignment="Center" VerticalAlignment="Bottom" Content="Музыка"/>
            <RadioButton x:Name="checkBoxMovie" HorizontalAlignment="Center" VerticalAlignment="Bottom" Content="Кино"/>
            <RadioButton x:Name="checkBoxReading" HorizontalAlignment="Center" VerticalAlignment="Bottom" Content="Чтение"/>
        </UniformGrid>
        <TextBlock Text="Страна проживания" FontSize="20" TextAlignment="Right" Margin="20"/>
        <ComboBox x:Name="comboBoxCountry">
            <ComboBoxItem Content="Россия"/>
            <ComboBoxItem Content="Беларусь"/>
            <ComboBoxItem Content="Казахстан"/>
        </ComboBox>
        <TextBlock x:Name="textBlockAge" Text="Возраст" FontSize="20" TextAlignment="Right" Margin="20"/>
        <Slider x:Name="sliderAge" Minimum="18" Maximum="100" ValueChanged="sliderAge_ValueChanged"/>
        <TextBlock x:Name="textBlock" FontSize="10"/>
        <Button Content="Показать результат" Click="Button_Click"/>
    </UniformGrid>
</Window>
