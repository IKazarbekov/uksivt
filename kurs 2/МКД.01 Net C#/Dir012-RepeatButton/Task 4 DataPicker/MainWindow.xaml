<Window x:Class="Task_4_DataPicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_4_DataPicker"
        mc:Ignorable="d"
        Title="MainWindow" Height="330" Width="300">
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Дешёвая гостиница в мире" FontSize="22" FontFamily="Trebuchet MS" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Text="Дата заезда" Grid.Row="1" FontSize="14" FontFamily="Trebuchet MS" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <DatePicker x:Name="dataPickerStart" Grid.Row="2"/>
        <TextBlock Text="Дата выезда" Grid.Row="3" FontSize="14" FontFamily="Trebuchet MS" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <DatePicker x:Name="dataPickerEnd" Grid.Row="4"/>
        <CheckBox x:Name="checkBox" Grid.Row="5" Content="Завтрак включён"/>
        <Button Content="Забронировать" Grid.Row="6" Margin="10" Click="Button_Click"/>
    </Grid>
</Window>
