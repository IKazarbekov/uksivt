<Window x:Class="Task_7_Vkladka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_7_Vkladka"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Window" Height="300" Width="300"
        Loaded="Window_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="LightForeground" Color="Black"/>
        <SolidColorBrush x:Key="LightBackground" Color="White"/>

        <SolidColorBrush x:Key="NightForeground" Color="White"/>
        <SolidColorBrush x:Key="NightBackground" Color="Black"/>

        <SolidColorBrush x:Key="CurrentForeground" Color="Black"/>
        <SolidColorBrush x:Key="CurrentBackground" Color="White"/>

        <sys:Double x:Key="CurrentFontSize">10</sys:Double>

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource CurrentFontSize}"/>
            <Setter Property="Background" Value="{DynamicResource CurrentBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource CurrentForeground}"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="FontSize" Value="{DynamicResource CurrentFontSize}"/>
            <Setter Property="Background" Value="{DynamicResource CurrentBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource CurrentForeground}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="{DynamicResource CurrentFontSize}"/>
            <Setter Property="Background" Value="{DynamicResource CurrentBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource CurrentForeground}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="{DynamicResource CurrentFontSize}"/>
            <Setter Property="Background" Value="{DynamicResource CurrentBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource CurrentForeground}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="{DynamicResource CurrentFontSize}"/>
            <Setter Property="Background" Value="{DynamicResource CurrentBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource CurrentForeground}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="{DynamicResource CurrentFontSize}"/>
        </Style>

    </Window.Resources>
    
    <DockPanel LastChildFill="True">
        <DockPanel DockPanel.Dock="Bottom">
            <Button DockPanel.Dock="Right" Content="Отмена" Click="Button_Click"/>
            <Button DockPanel.Dock="Left" Content="Сохранить" Click="Button_Click_1"/>
        </DockPanel>
        <TabControl>
            <TabItem Header="Основные" x:Name="tabItemMain">
                <StackPanel Margin="10">
                    <TextBlock x:Name="textBlockLanguage" Text="Язык" />
                    <ComboBox x:Name="comboBoxLanguages" SelectionChanged="ComboBox_SelectionChanged"  Background="{DynamicResource CurrentBackground}" 
                               >
                    </ComboBox>
                    <Separator/>
                    <CheckBox x:Name="checkBoxAutoLoad" Content="Автозагрузка" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Вид" x:Name="tabItemView"   >
                <StackPanel Margin="10">
                    <TextBlock  Text="Тема" x:Name="textBlockTopic"/>
                    <RadioButton  x:Name="radioButtonLight" GroupName="topic" Content="Светлая" Checked="radioButtonLight_Checked"/>
                    <RadioButton  x:Name="radioButtonNight" GroupName="topic" Content="Тёмная" Checked="radioButtonNight_Checked"/>
                    <RadioButton   x:Name="radioButtonSystem"  GroupName="topic" Content="Системная"/>
                    <Separator/>
                    <TextBlock Text="Развер шрифта" x:Name="textBlockFontSize"/>
                    <Slider x:Name="sliderFontSize" ValueChanged="sliderFontSize_ValueChanged" Minimum="10" Maximum="100"/>
                </StackPanel>
            </TabItem>
            <TabItem  Header="Дополнительно" x:Name="tabItemAdditionlly">
                <StackPanel Margin="10">
                    <CheckBox x:Name="checkBoxModeDeveloper" Content="Режим разработчика"  Checked="checkBoxModeDeveloper_Checked"/>
                    <Separator/>
                    <TextBlock x:Name="textBlockLevelLog" Text="Уровень логирования" />
                    <ComboBox x:Name="comboBoxLog" >
                        <ComboBoxItem   x:Name="ComboBoxItemError" Content="Ошибки"/>
                        <ComboBoxItem   x:Name="ComboBoxItemWarning" Content="Предупреждения"/>
                        <ComboBoxItem   x:Name="ComboBoxItemInformation" Content="Информация"/>
                    </ComboBox>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
