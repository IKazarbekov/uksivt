<Window x:Class="Task_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_1"
        mc:Ignorable="d"
        Title="MainWindow" Height="300" Width="300">
    <StackPanel>
        <Calendar x:Name="calendar" SelectedDatesChanged="calendar_SelectedDatesChanged"/>
        <DatePicker x:Name="dataPicker" SelectedDateChanged="DatePicker_SelectedDateChanged"/>
    </StackPanel>
</Window>
