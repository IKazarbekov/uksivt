<Window x:Class="Calculate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculate"
        mc:Ignorable="d"
        Title="Калькулятор" Height="487" Width="400">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <WrapPanel DockPanel.Dock="Top">
                <TextBox x:Name="textFirstNumber" FontSize="50" TextChanged="textFirstNumber_TextChanged" MinWidth="40">47</TextBox>
                <TextBox x:Name="textOperations"  FontSize="50" TextChanged="textOperations_TextChanged" MinWidth="40">-</TextBox>
                <TextBox x:Name="textSecondNumber"   FontSize="50" TextChanged="textSecondNumber_TextChanged" MinWidth="40">36</TextBox>
                <TextBox x:Name="textResult" FontSize="50" MinWidth="0">=30</TextBox>
            </WrapPanel>
            <TextBox x:Name="textStatus" FontSize="10" Foreground="Red" Background="AliceBlue">Добро пожаловать в калькулятор!</TextBox>
        </DockPanel>

        <UniformGrid DockPanel.Dock="Bottom" Rows="4" Columns="4">
            <Button  Content="C" FontSize="36" Click="Button_Click_Clear" Margin="5,5,5,5" Background="AliceBlue"/>
            <Button  Content="/" FontSize="36" Click="Button_Click_Division" Margin="5,5,5,5" Background="AliceBlue"/>
            <Button  Content="*" FontSize="36" Click="Button_Click_Multiplication" Margin="5,5,5,5" Background="AliceBlue"/>
            <Button  Content="-" FontSize="36" Click="Button_Click_Subtract" Margin="5,5,5,5" Background="AliceBlue"/>
            <Button  Content="9" FontSize="36" Click="Button_Click_9" Margin="5,5,5,5" Background="AliceBlue"/>
            <Button  Content="8" FontSize="36" Click="Button_Click_8" Margin="5,5,5,5" Background="AliceBlue"/>
            <Button  Content="7" FontSize="36" Click="Button_Click_7" Margin="5,5,5,5" Background="AliceBlue"/>
            <Button  Content="+" FontSize="36" Click="Button_Click_Addition" Margin="5,5,5,5" Background="AliceBlue"/>
            <Button  Content="4" FontSize="36" Click="Button_Click_4" Margin="5,5,5,5" Background="AliceBlue"/>
            <Button  Content="5" FontSize="36" Click="Button_Click_5" Margin="5,5,5,5" Background="AliceBlue"/>
            <Button  Content="6" FontSize="36" Click="Button_Click_6" Margin="5,5,5,5" Background="AliceBlue"/>
            <Button  Content="=" FontSize="36" Click="Button_Click_result" Margin="5,5,5,5" Background="AliceBlue"/>
            <Button  Content="1" FontSize="36" Click="Button_Click_1" Margin="5,5,5,5" Background="AliceBlue"/>
            <Button  Content="2" FontSize="36" Click="Button_Click_2" Margin="5,5,5,5" Background="AliceBlue"/>
            <Button  Content="3" FontSize="36" Click="Button_Click_3" Margin="5,5,5,5" Background="AliceBlue"/>
            <UniformGrid Rows="2">
                <Button  Content="0" FontSize="25" Click="Button_Click_0" Margin="5,5,5,5" Background="AliceBlue"/>
                <Button  Content="," FontSize="25" Click="Button_Click_Point" Margin="5,5,5,5" Background="AliceBlue"/>
            </UniformGrid>
        </UniformGrid>
    </DockPanel>

</Window>
