<Window x:Class="Calculator_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator_3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="300"
        MinHeight="400" MinWidth="200">
    <Window.Resources>
        <Style x:Key="borderButtonStyle" TargetType="Border">
            <Setter Property="Background" Value="MediumSlateBlue"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style x:Key="buttonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <EventSetter Event="Click" Handler="Button_Click"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top"
                CornerRadius="30"
                Background="Blue"
                Margin="10">
            <DockPanel Margin="20">
                <TextBox x:Name="textBoxMain"
                         Background="Blue"
                         Foreground="White"
             DockPanel.Dock="Top"
             Height="60"
             FontSize="30"
             PreviewTextInput="textBoxMain_PreviewTextInput"
                         HorizontalScrollBarVisibility="Auto"
                         KeyDown="textBoxMain_KeyDown"
       />
                <TextBox x:Name="textBoxResult"
                         Background="Blue"
                         Foreground="White"
             DockPanel.Dock="Top"
             Height="30"
             FontSize="20"
             TextAlignment="Right"
             PreviewTextInput="textBoxResult_PreviewTextInput"
       />
            </DockPanel>
        </Border>
        
        <UniformGrid Columns="3"
                     Margin="10">
            <UniformGrid Columns="2">
                <Border Style="{StaticResource borderButtonStyle}" >
                    <Button Content="+"
                    Style="{StaticResource buttonStyle}"
                    />
                </Border>
                <Border Style="{StaticResource borderButtonStyle}" >
                    <Button Content="-"
                    Style="{StaticResource buttonStyle}"
                    />
                </Border>
            </UniformGrid>
            <UniformGrid Columns="2">
                <Border Style="{StaticResource borderButtonStyle}" >
                    <Button Content="*"
                    Style="{StaticResource buttonStyle}"
                    />
                </Border>
                <Border Style="{StaticResource borderButtonStyle}" >
                    <Button Content="/"
                    Style="{StaticResource buttonStyle}"
                    />
                </Border>
            </UniformGrid>
            <Border Style="{StaticResource borderButtonStyle}" >
                <Button Content="="
                    Style="{StaticResource buttonStyle}"
                    />
            </Border>
            <Border Style="{StaticResource borderButtonStyle}" >
                <Button Content="1"
                    Style="{StaticResource buttonStyle}"
                    />
            </Border>
            <Border Style="{StaticResource borderButtonStyle}" >
                <Button Content="2"
                    Style="{StaticResource buttonStyle}"
                    />
            </Border>
            <Border Style="{StaticResource borderButtonStyle}" >
                <Button Content="3"
                    Style="{StaticResource buttonStyle}"
                    />
            </Border>
            <Border Style="{StaticResource borderButtonStyle}" >
                <Button Content="4"
                    Style="{StaticResource buttonStyle}"
                    />
            </Border>
            <Border Style="{StaticResource borderButtonStyle}" >
                <Button Content="5"
                    Style="{StaticResource buttonStyle}"
                    />
            </Border>
            <Border Style="{StaticResource borderButtonStyle}" >
                <Button Content="6"
                    Style="{StaticResource buttonStyle}"
                    />
            </Border>
            <Border Style="{StaticResource borderButtonStyle}" >
                <Button Content="7"
                    Style="{StaticResource buttonStyle}"
                    />
            </Border>
            <Border Style="{StaticResource borderButtonStyle}" >
                <Button Content="8"
                    Style="{StaticResource buttonStyle}"
                    />
            </Border>
            <Border Style="{StaticResource borderButtonStyle}" >
                <Button Content="9"
                    Style="{StaticResource buttonStyle}"
                    />
            </Border>
            <UniformGrid Columns="2">
                <Border Style="{StaticResource borderButtonStyle}" >
                    <Button Content="%"
                    Style="{StaticResource buttonStyle}"
                    />
                </Border>
                <Border Style="{StaticResource borderButtonStyle}" >
                    <Button Content=","
                    Style="{StaticResource buttonStyle}"
                    />
                </Border>
            </UniformGrid>
            <Border Style="{StaticResource borderButtonStyle}" >
                <Button Content="0"
                    Style="{StaticResource buttonStyle}"
                    />
            </Border>
            <UniformGrid Columns="2">
                <Border Style="{StaticResource borderButtonStyle}" >
                    <Button Content="del"
                    Style="{StaticResource buttonStyle}"
                    />
                </Border>
                <Border Style="{StaticResource borderButtonStyle}" >
                    <Button Content="C"
                    Style="{StaticResource buttonStyle}"
                    />
                </Border>
            </UniformGrid>
        </UniformGrid>
    </DockPanel>
</Window>
