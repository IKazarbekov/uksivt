<Window x:Class="Ckiler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ckiler"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Background>
        <ImageBrush x:Name="ImageBrushWindow" ImageSource="/resourses/класс.jpg"/>
    </Window.Background>
    <DockPanel>
        <UniformGrid x:Name="UniformGridButtons" DockPanel.Dock="Left" Rows="4" Visibility="Collapsed">
            <Button x:Name="ButtonAddStudent" Content="Позвать студента" Click="Button_Click_2"/>
            <Button x:Name="ButtonDrop" Content="Выбросить все тетради" Click="Button_Click_1"/>
            <Button x:Name="ButtonChangeLocation" Content="Сменить локацию" Click="Button_Click_3"/>
            <Button x:Name="ButtonChangeColor" Content="Сменить цвет" Click="Button_Click_4"/>
        </UniformGrid>
        <TextBlock x:Name="LabelStatus" DockPanel.Dock="Top" Text="Кол-во тетрадей:" Width="663" Foreground="White" FontSize="22" Visibility="Visible">
            <TextBlock.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#820056FF"/>
                    <GradientStop Color="#7FFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </TextBlock.Background>
        </TextBlock>
        <DockPanel DockPanel.Dock="Bottom">
            <Label x:Name="MainLabel" DockPanel.Dock="Left" Content="Учитель: Где твои тетради?" FontSize="20" Background="#FF00CAFF"/>
            <Button x:Name="MainButton2" DockPanel.Dock="Right" Content="Остаться на паре" Click="Button2_Click" Width="300" Visibility="Collapsed"/>
            <Button x:Name="MainButton" DockPanel.Dock="Right" Content="Не знаю" Click="Button_Click"/>
        </DockPanel>
        <Canvas>
        </Canvas>
    </DockPanel>
</Window>
