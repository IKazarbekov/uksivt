<Window x:Class="ViewImages.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ViewImages"
        mc:Ignorable="d"
        Title="Просмоторщик изображений" Height="450" Width="500">
    <Window.Background>
        <ImageBrush x:Name="image"/>
    </Window.Background>
    <DockPanel>
        <TextBlock x:Name="textBlock"
                   DockPanel.Dock="Top"
                   FontSize="20"
                   Foreground="White"
                   Text="Выберите изображения">
            <TextBlock.Background>
                <LinearGradientBrush>
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </TextBlock.Background>
        </TextBlock>
        <Button Content="Предыдущий" DockPanel.Dock="Left" Click="Button_Click_2"
                Background="Transparent" BorderBrush="Transparent"
                >
            <Button.Template>
                <ControlTemplate>
                        
                        <Label Content="(--"
                               Foreground="White"
                               FontSize="30"
                               VerticalContentAlignment="Center"
                                   />
                </ControlTemplate>
            </Button.Template>
        </Button>
            <Button Content="Следующий" DockPanel.Dock="Right" Click="Button_Click_1"
                Background="Transparent" BorderBrush="Transparent"
                        >
            <Button.Template>
                <ControlTemplate>

                    <Label Content="--)"
                       Foreground="White"
                       FontSize="30"
                       VerticalContentAlignment="Center"
                           />
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Border DockPanel.Dock="Bottom" CornerRadius="15" 
                Background="CadetBlue" Margin="0 0 0 10"
                BorderBrush="Transparent">
            <Button Content="Загрузить" Click="Button_Click"
                    Padding="10" Background="Transparent"
                    FontSize="20" FontFamily="Arial"
                    />
        </Border>
        <Separator Visibility="Collapsed"/>
    </DockPanel>
</Window>
