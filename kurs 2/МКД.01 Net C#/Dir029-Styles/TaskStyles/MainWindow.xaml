<Window x:Class="TaskStyles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskStyles"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="400"
        WindowStyle="None" Background="AliceBlue">
    <Window.Resources>
        <Style x:Key="greenLabel" TargetType="Label">
            <Setter Property="Background" Value="Blue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Label">
                        <Border BorderBrush="Blue"
                                Background="Blue"
                                CornerRadius="20"
                                Padding="20">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Content="Группа 24П-2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
        </Style>
        <Style TargetType="Button" x:Key="redButton">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Red"/>
        </Style>
        <Style TargetType="Button" x:Key="blueButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Blue"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="30">
        <Label Style="{StaticResource greenLabel}"/>
        <Label Content="Кол-во человек"/>
        <TextBox x:Name="tb1"/>
        <Label Content="Бюджетная / Комерция"/>
        <ComboBox x:Name="cb">
            <ComboBoxItem Content="Бюджетная"/>
            <ComboBoxItem Content="Коммерция"/>
        </ComboBox>
        <Label Content="ФИО студента ТОП-1 в группе 24П-2"/>
        <TextBox x:Name="tb2"/>
        <Label Content="Куратор"/>
        <TextBox x:Name="tb3"/>
        <Separator Height="20" Visibility="Hidden"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Отправить" Style="{StaticResource blueButton}"
                    Width="80" Click="Button_Click_1"/>
            <Separator Width="15" Visibility="Hidden"/>
            <Button Content="УЙТИ С ГРУППЫ" Style="{StaticResource redButton}"
                    Height="40" Width="130" Click="Button_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
