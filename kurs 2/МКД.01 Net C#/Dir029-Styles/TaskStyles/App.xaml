<Application x:Class="TaskStyles.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TaskStyles"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="green">LightGreen</SolidColorBrush>
        <Style TargetType="Label" x:Key="greenLabel">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Background="{StaticResource green}" CornerRadius="20" Padding="20">
                            <ContentPresenter Content="Результат" HorizontalAlignment="Center"
                                              />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Border" x:Key="border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="0 20"/>
        </Style>
        <Style x:Key="greenButton" TargetType="Button">
            <Setter Property="Foreground" Value="LightGreen"/>
            <Setter Property="BorderBrush" Value="LightGreen"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style x:Key="greenBlButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="LightGreen"/>
            <Setter Property="Background" Value="LightGreen"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="greenLabelKurator" TargetType="Label">
            <Setter Property="Foreground" Value="LightGreen"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Application.Resources>
</Application>
