<Window x:Class="ShopTask.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localData="clr-namespace:ShopTask.data"
        xmlns:local="clr-namespace:ShopTask"
        mc:Ignorable="d"
        Title="ProductsWindow" Height="800" Width="1300"
        Closed="Window_Closed" WindowStyle="None" AllowsTransparency="True" MouseDown="Window_MouseDown"
        Background="AliceBlue">
    <TabControl>
        <TabItem Header="Редактирование товаров">
            <DataGrid ItemsSource="{Binding Source={x:Static localData:ProductsData.Products}}"/>
        </TabItem>
        <TabItem Header="Редактирование продавцов">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left"/>
                <DataGrid DockPanel.Dock="Right" ItemsSource="{Binding Source={x:Static localData:UsersData.Users}}"/>
            </DockPanel>
        </TabItem>
        <TabItem Header="Товары">
            <WrapPanel>
                
            </WrapPanel>
        </TabItem>
        <TabItem Header="Корзина"/>
        <TabItem Header="Продажи"/>
    </TabControl>
</Window>
