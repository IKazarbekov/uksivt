<Window x:Class="ShopTask2.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopTask2"
        mc:Ignorable="d"
        Title="Авторизация" 
        Height="850" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="300"/>
    </WindowChrome.WindowChrome>
    
    <Border Background="#F4F7F9" CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Color="#33000000" Direction="270" ShadowDepth="5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,10,15,0">
                <Button Content="" Width="12" Height="12" Background="#FFBD44" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="BtnClose" Content="" Width="12" Height="12" Background="#FF605C" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="40,20,40,40" VerticalAlignment="Center">

                <Border Width="65" Height="65" CornerRadius="20" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#667eea" Offset="0"/>
                            <GradientStop Color="#764ba2" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="🛒" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Добро пожаловать" FontSize="26" FontWeight="Bold" Foreground="#2D3748" HorizontalAlignment="Center"/>
                <TextBlock Text="Войдите в свой аккаунт ShopTask" FontSize="12" Foreground="#A0AEC0" HorizontalAlignment="Center" Margin="0,5,0,30"/>

                <TextBlock Text="Логин пользователя" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,8"/>
                <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Height="80" Margin="0,0,0,20">
                    <TextBox x:Name="TxtUsername" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="15,0,15,0" FontSize="14" Foreground="#2D3748" TextChanged="TextChanged"/>
                </Border>

                <TextBlock Text="Пароль" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,8"/>
                <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Height="45" Margin="0,0,0,25">
                    <PasswordBox x:Name="TxtPassword" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="15,0,15,0" FontSize="14" Foreground="#2D3748" PasswordChanged="TxtPassword_PasswordChanged"/>
                </Border>

                <Button x:Name="BtnLogin" Height="100" Margin="0,10,0,0" Cursor="Hand" Click="BtnLogin_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#667eea" Offset="0"/>
                                        <GradientStop Color="#764ba2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Content>
                        <TextBlock Text="Войти в систему"/>
                    </Button.Content>
                </Button>

                <Button Background="Transparent" BorderBrush="Transparent" Click="Button_Click2">
                    <TextBlock HorizontalAlignment="Center" Margin="0,25,0,0" FontSize="13">
                        <Hyperlink Foreground="#764ba2">Забыли пароль?</Hyperlink>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>