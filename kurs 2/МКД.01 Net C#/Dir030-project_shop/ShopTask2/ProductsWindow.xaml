<Window x:Class="ShopTask.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localData="clr-namespace:ShopTask.data"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:ShopTask"
        mc:Ignorable="d"
        Title="ProductsWindow"
        Closed="Window_Closed" WindowStyle="None" AllowsTransparency="True" MouseDown="Window_MouseDown"
        ResizeMode="CanResize"
        Style="{DynamicResource window}">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <EventTrigger.Actions>
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                         Storyboard.TargetProperty="Height"
                         From="0" To="800" Duration="0:0:2"
                         >
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger.Actions>

        </EventTrigger>
    </Window.Triggers>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="5"
                      ResizeBorderThickness="10"
                      GlassFrameThickness="0"
                      CornerRadius="50"
                      />
    </WindowChrome.WindowChrome>
        <TabControl SelectionChanged="TabControl_Selected">
        <TabControl.Triggers>
            <EventTrigger RoutedEvent="TabControl.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <ThicknessAnimation
                            Storyboard.TargetProperty="Margin"
                            From="1000 0 -1000 0" To="0 0 0 0" Duration="0:0:3"
                            >
                            <ThicknessAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseOut"/>
                            </ThicknessAnimation.EasingFunction>
                        </ThicknessAnimation>
                        <DoubleAnimation
                            Storyboard.TargetProperty="Opacity"
                            From="0.0" To="1.0" Duration="0:0:2"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </TabControl.Triggers>
        <TabItem Header="Редактирование товаров" x:Name="tabItemEditProducts" MouseRightButtonDown="TabItem_OutTab">
            <DockPanel>
                <Button Content="+" DockPanel.Dock="Top" Click="ButtonAddProduct_Click"/>
                <DataGrid
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              x:Name="dataGridProductsEdit" RowHeight="120" >
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Изображение" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Button Background="Transparent" Click="Button_Click_ImageChange">
                                            <Button.Template>
                                                <ControlTemplate>
                                                    <Border CornerRadius="0"
                                                        Margin="0"
                                                        Padding="0">
                                                        <Image Source="{Binding Image}" Height="80"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" FontSize="20" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="250">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <!-- 1. Включаем перенос слов -->
                                    <Setter Property="TextWrapping" Value="Wrap"/>

                                    <!-- 2. (Опционально) Добавляем выравнивание по высоте, чтобы текст смотрелся аккуратно -->
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Price}" FontSize="20" Width="0.5*" />
                        <DataGridTextColumn Header="На складе" Binding="{Binding Count}" FontSize="20" Width="0.5*" />
                        <DataGridTemplateColumn Header="Категория" Width="*" SortMemberPath="Category">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding CategoryValues}" SelectedItem="{Binding Category}"
                                                  VerticalAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Label Content="{Binding}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Настройки" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <UniformGrid Rows="1">
                                        <Button Content="Удалить" Click="Button_Click_RemoveProduct"/>
                                    </UniformGrid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
            </TabItem>
        <TabItem x:Name="tabItemSeller" Header="Продавцы" MouseRightButtonDown="TabItem_OutTab">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left"/>
                    <DataGrid DockPanel.Dock="Right" x:Name="dataGridUser"/>
                </DockPanel>
            </TabItem>
        <TabItem x:Name="tabItemProducts" Header="Товары" MouseRightButtonDown="TabItem_OutTab">
                <DockPanel>
                <StackPanel DockPanel.Dock="Right" MouseEnter="buttonSeller_MouseEnter">
                    <Label Content="Оплата"/>
                    <TextBlock x:Name="textBlockPriceSell" Text="Имя клиента"/>
                    <TextBox x:Name="textBoxClient"/>
                    <Button Content="Перейти к оплате" Click="Button_Click_Seller" x:Name="buttonSeller" MouseEnter="buttonSeller_MouseEnter"/>
                </StackPanel>
                    <ScrollViewer>
                        <WrapPanel x:Name="productsPanel">
                        </WrapPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

        <TabItem x:Name="tabItemSale" Header="Продажи" MouseRightButtonDown="TabItem_OutTab">
            <ListView x:Name="dataGridSales" FontSize="40">

            </ListView>
        </TabItem>
        <TabItem x:Name="tabItemSettings">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                    <Label Content="Настройки" FontWeight="Thin" x:Name="labelSettings"/>
                    <UniformGrid Columns="4">
                            <Button Content="-" Click="Button_Click_HiddenWindow"/>
                            <Button Content="[]" Click="Button_Click_ChangeSizeWindow"/>
                            <Button Content="X" Click="Button_Click_CloseWindow"/>
                            <Button Content="->" Click="Button_Click_Logout" x:Name="buttonLogout"/>
                    </UniformGrid>
                    </StackPanel>
                </TabItem.Header>
            <Grid>
                <ScrollViewer Width="700">
                    <StackPanel>
                        <Label Content="Пользователь"/>
                        <TextBlock Text="Имя"/>
                        <TextBlock Text="Пароль"/>
                        <Label Content="Интерфейс"/>
                        <RadioButton Content="Классика" Click="RadioButtonThemeClassic_Click"/>
                        <RadioButton Content="Тёмная тема" Click="RadioButtonThemeDark_Click"/>
                        <RadioButton Content="Летняя тема" Click="RadioButtonThemeSummer_Click"/>
                        <RadioButton Content="Альфа" Click="RadioButtonThemeAlpha_Click"/>
                        <UniformGrid Columns="3">
                            <TextBlock Text="Размер заголовков"/>
                            <Slider x:Name="sliderSizeLabel" Minimum="10" Maximum="50" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SliderSizeLabel_ValueChanged"/>
                            <TextBlock Text="{Binding ElementName=sliderSizeLabel,Path=Value,Mode=TwoWay}"/>
                        </UniformGrid>
                        <Label Content="О нас"/>
                        <TextBlock Text="Пароль"/>
                        <Label Content="Отзывы"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            </TabItem>
        </TabControl>
</Window>
