<Window x:Class="ShopTask2.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopTask2"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="400"
        Background="AliceBlue" AllowsTransparency="True" WindowStyle="None"
        WindowStartupLocation="CenterScreen">
    <StackPanel>
        <Label Content="Магазин"/>
        <TextBlock Text="Вход в систему"/>
        <TextBlock Text="Логин"/>
        <TextBox x:Name="textBoxLogin" TextChanged="textBox_TextChanged"/>
        <TextBlock Text="Пароль"/>
        <TextBox x:Name="textBoxPassword" TextChanged="textBox_TextChanged"/>
        <Button x:Name="button" Content="Войти" Click="Button_Click"/>
    </StackPanel>
</Window>