<Window x:Class="Работа2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Работа2"
        mc:Ignorable="d"
        Title="Анкета" Height="450" Width="311">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20">Фамилия</Label>
        <Label Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20">Имя</Label>
        <Label Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20">Отчество</Label>
        <Label Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="20">Описание проблемы</Label>
        <TextBlock Grid.Row="5" FontSize="13" Text="Электронная почта" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <RichTextBox x:Name="textBoxProblem" Grid.Row="4" Grid.ColumnSpan="2" Margin="12,8,9,8" TextChanged="textBoxProblem_TextChanged"/>
        <TextBox x:Name="textBoxFirstName" Grid.Row="0" Grid.Column="1" Margin="9,8,9,8" TextChanged="textBoxFirstName_TextChanged" MaxLength="50"/>
        <TextBox x:Name="textBoxSecondName" Grid.Row="1" Grid.Column="1" Margin="9,8,9,8" TextChanged="textBoxSecondName_TextChanged" MaxLength="50"/>
        <TextBox x:Name="textBoxThreeName" Grid.Row="2" Grid.Column="1" Margin="9,8,9,8" TextChanged="textBoxThreeName_TextChanged" MaxLength="50"/>
        <TextBox x:Name="textBoxEmail" Grid.Row="5" Grid.Column="1" Margin="9,8,9,8" TextChanged="textBoxEmail_TextChanged"/>
        <Button x:Name="buttonPush" IsEnabled="False" Content="Отправка" Grid.Column="1" Grid.Row="6" Margin="10,10,10,10" Click="buttonPush_Click" />
        <UniformGrid Grid.Row="6" Columns="4">
            <Label>М</Label>
            <RadioButton x:Name="radioButtonM"></RadioButton>
            <Label>Ж</Label>
            <RadioButton x:Name="radioButtonW" IsChecked="True"></RadioButton>
        </UniformGrid>
    </Grid>
</Window>
