<Window x:Class="Notepad_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Notepad_2"
        mc:Ignorable="d"
        Title="FeatherPad OS Ultra Studio Pro" Height="850" Width="1350"
        MinHeight="600" MinWidth="950"
        Closing="Window_Closing"
        Background="{DynamicResource WindowBgBrush}">

    <Window.Resources>
        <!-- Базовые динамические ресурсы UI по умолчанию -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="PanelBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MenuBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextDefBrush" Color="#111111"/>
        <SolidColorBrush x:Key="EditorBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="EditorFgBrush" Color="#000000"/>
        <SolidColorBrush x:Key="NumPanelBgBrush" Color="#F9F9F9"/>
        <SolidColorBrush x:Key="NumPanelFgBrush" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="AccentColor" Color="#0078D4"/>
        <SolidColorBrush x:Key="BorderBrushDef" Color="#E5E5E5"/>

        <!-- Стилизация кнопок Тулбара -->
        <Style x:Key="FluentToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDefBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushDef}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ВЕРХНЕЕ МЕНЮ (МЕНЯЕТ ЦВЕТ) -->
        <Menu DockPanel.Dock="Top" FontSize="14" Background="{DynamicResource MenuBgBrush}" Foreground="{DynamicResource TextDefBrush}" Padding="6,4" BorderBrush="{DynamicResource BorderBrushDef}" BorderThickness="0,0,0,1">
            <MenuItem Header="Файл" Foreground="{DynamicResource TextDefBrush}">
                <MenuItem Header="Новый лист" Click="Button_Click_New_File" InputGestureText="Ctrl+N"/>
                <MenuItem Header="Открыть файл..." Click="Button_Click_Open_File" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="Сохранить" Click="Button_Click_Save_File" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Сохранить как..." Click="Button_Click_Save_File_As"/>
                <MenuItem Header="Сохранить ВСЁ" Click="MenuItem_SaveAll_Click"/>
                <Separator/>
                <MenuItem Header="Печать..." Click="Button_Click_Print" InputGestureText="Ctrl+P"/>
                <Separator/>
                <MenuItem Header="Выйти" Click="MenuItem_Exit_Click"/>
            </MenuItem>

            <MenuItem Header="Правка" Foreground="{DynamicResource TextDefBrush}">
                <MenuItem Header="Шаг назад" Command="ApplicationCommands.Undo"/>
                <MenuItem Header="Шаг вперед" Command="ApplicationCommands.Redo"/>
                <Separator/>
                <MenuItem Header="Вырезать" Command="ApplicationCommands.Cut"/>
                <MenuItem Header="Копировать" Command="ApplicationCommands.Copy"/>
                <MenuItem Header="Вставить" Command="ApplicationCommands.Paste"/>
                <Separator/>
                <MenuItem Header="Сортировка строк А-Я" Click="MenuItem_SortLines_Click"/>
                <MenuItem Header="Удалить пустые строки" Click="MenuItem_RemoveEmptyLines_Click"/>
                <MenuItem Header="Штамп Времени" Click="MenuItem_InsertDateTime_Click" InputGestureText="F7"/>
            </MenuItem>

            <MenuItem Header="Супер-Утилиты" Foreground="{DynamicResource TextDefBrush}">
                <MenuItem Header="Посчитать мат. выражение в тексте" Click="Util_Calculate_Click" InputGestureText="Ctrl+Shift+C"/>
                <MenuItem Header="Текст снегенированный Кириллом, Альмиром, Даниилой, Русланом" Click="Util_Lorem_Click"/>
                <Separator/>
                <MenuItem Header="Вычислить MD5 Хеш" Click="Util_MD5_Click"/>
                <MenuItem Header="Вычислить SHA-256 Хеш" Click="Util_SHA256_Click"/>
                <Separator/>
                <MenuItem Header="Перевести Текст в ВЕРХНИЙ РЕГИСТР" Click="Util_Upper_Click"/>
                <MenuItem Header="Перевести текст в нижний регистр" Click="Util_Lower_Click"/>
            </MenuItem>

            <MenuItem Header="Голос" Foreground="{DynamicResource TextDefBrush}">
                <MenuItem Header="Озвучить выделенный текст" Click="Voice_Speak_Click" InputGestureText="F5"/>
                <MenuItem Header="Остановить чтение" Click="Voice_Stop_Click"/>
            </MenuItem>

            <MenuItem Header="Вид" Foreground="{DynamicResource TextDefBrush}">
                <MenuItem Header="Боковой Проводник" Click="Click_Left_Panel_Items" InputGestureText="F9"/>
                <MenuItem Header="Панель Настроек и Магии" Click="ToggleSettingsSidebar_Click" InputGestureText="F12"/>
            </MenuItem>
        </Menu>

        <!-- ТУЛБАР (МЕНЯЕТ ЦВЕТ) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource MenuBgBrush}" BorderBrush="{DynamicResource BorderBrushDef}" BorderThickness="0,0,0,1" Padding="5,2">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource FluentToolbarButton}" Click="Button_Click_New_File" ToolTip="Новый файл">
                        <TextBlock Text="📄" FontSize="16" Foreground="{DynamicResource TextDefBrush}"/>
                    </Button>
                    <Button Style="{StaticResource FluentToolbarButton}" Click="Button_Click_Open_File" ToolTip="Открыть">
                        <TextBlock Text="📂" FontSize="16" Foreground="{DynamicResource TextDefBrush}"/>
                    </Button>
                    <Button Style="{StaticResource FluentToolbarButton}" Click="Button_Click_Save_File" ToolTip="Сохранить текущую вкладку">
                        <TextBlock Text="💾" FontSize="16" Foreground="{DynamicResource AccentColor}"/>
                    </Button>
                    <Separator Margin="5,4"/>
                    <Button Style="{StaticResource FluentToolbarButton}" Command="ApplicationCommands.Undo" ToolTip="Назад">
                        <TextBlock Text="↩" FontSize="18" Foreground="{DynamicResource TextDefBrush}"/>
                    </Button>
                    <Button Style="{StaticResource FluentToolbarButton}" Command="ApplicationCommands.Redo" ToolTip="Вперед">
                        <TextBlock Text="↪" FontSize="18" Foreground="{DynamicResource TextDefBrush}"/>
                    </Button>
                    <Separator Margin="5,4"/>
                    <Button Style="{StaticResource FluentToolbarButton}" Click="Click_Left_Panel_Items" ToolTip="Проводник документов">
                        <TextBlock Text="📁" FontSize="16" Foreground="{DynamicResource TextDefBrush}"/>
                    </Button>
                    <Button Style="{StaticResource FluentToolbarButton}" Click="ToggleSettingsSidebar_Click" ToolTip="Панель кастомизации">
                        <TextBlock Text="⚙" FontSize="18" Foreground="{DynamicResource TextDefBrush}"/>
                    </Button>
                </StackPanel>

                <!-- Блок быстрого аудио-плеера в тулбаре -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="🎧 Фоновый Звук: " VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextDefBrush}"/>
                    <ComboBox x:Name="comboAudioAmbience" Width="120" Height="25" VerticalContentAlignment="Center" Margin="5,0" SelectedIndex="0" SelectionChanged="ComboAudioAmbience_SelectionChanged">
                        <ComboBoxItem Content="Выключен"/>
                        <ComboBoxItem Content="Шум Дождя"/>
                        <ComboBoxItem Content="Лесной Костёр"/>
                        <ComboBoxItem Content="Звуки Поезда"/>
                    </ComboBox>
                    <Slider x:Name="sliderAudioVolume" Width="70" Minimum="0" Maximum="1" Value="0.5" VerticalAlignment="Center" ValueChanged="SliderAudioVolume_ValueChanged" ToolTip="Громкость атмосферы"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- СТАТУС-БАР -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource MenuBgBrush}" BorderBrush="{DynamicResource BorderBrushDef}" BorderThickness="0,1,0,0" Padding="12,5" Foreground="{DynamicResource TextDefBrush}">
            <StatusBarItem>
                <TextBlock x:Name="textBlockInfo" Text="Студия запущена стабильно." FontWeight="Medium"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="lblLinesCount" Text="Строк: 1"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="lblCharCount" Text="Символов: 0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="lblZoom" Text="Масштаб: 100%" Foreground="{DynamicResource AccentColor}" FontWeight="Bold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="lblBackupStatus" Text="Автобэкап активен" Foreground="Green" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ПОИСК И ЗАМЕНА -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource MenuBgBrush}" BorderBrush="{DynamicResource BorderBrushDef}" BorderThickness="0,1,0,0" Height="50" Visibility="Collapsed" x:Name="SearchPanel">
            <DockPanel LastChildFill="True" Margin="15,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Далее ▶" Margin="3" Padding="8,4" Click="buttonFindNext_Click"/>
                    <Button Content="◀ Назад" Margin="3" Padding="8,4" Click="buttonFindBack_Click"/>
                    <ToggleButton x:Name="buttonWithCase" Content="Aa" Width="35" Height="26" Margin="2"/>
                    <ToggleButton x:Name="buttonRegex" Content=".*" Width="35" Height="26" Margin="2"/>
                    <Button Content="✕" Width="26" Height="26" Margin="5,0,0,0" Click="CloseSearchPanel_Click" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextDefBrush}"/>
                </StackPanel>
                <TextBlock Text="Найти:" VerticalAlignment="Center" Margin="5,0,10,0" Foreground="{DynamicResource TextDefBrush}"/>
                <TextBox x:Name="textBoxFind" Style="{StaticResource FluentTextBox}" Height="28" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ЛЕВЫЙ ПРОВОДНИК (МЕНЯЕТ ЦВЕТ) -->
        <Border x:Name="LeftSidebar" Width="220" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrushDef}" BorderThickness="0,0,1,0" DockPanel.Dock="Left">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="АКТИВНЫЕ ЛИСТЫ" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextDefBrush}" Margin="5,0,0,8"/>
                <ListBox Grid.Row="1" x:Name="lstSidebarFiles" Background="Transparent" BorderThickness="0" SelectionChanged="LstSidebarFiles_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="5" Padding="8,6" Background="{DynamicResource PanelBgBrush}" Margin="0,2" BorderBrush="{DynamicResource BorderBrushDef}" BorderThickness="1">
                                <TextBlock Text="{Binding HeaderText}" Foreground="{DynamicResource TextDefBrush}" FontWeight="Medium"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ПРАВАЯ СУПЕР-ПАНЕЛЬ С ОГРОМНЫМ НАБОРОМ НАСТРОЕК -->
        <Border x:Name="RightSettingsSidebar" Width="320" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrushDef}" BorderThickness="1,0,0,0" DockPanel.Dock="Right" Visibility="Collapsed">
            <TabControl Background="Transparent" BorderThickness="0">
                <!-- ВКЛАДКА НАСТРОЕК UI -->
                <TabItem Header="Интерфейс">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <TextBlock Text="КОНФИГУРАТОР ТЕМ" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextDefBrush}"/>

                            <ComboBox x:Name="comboThemes" SelectedIndex="0" SelectionChanged="ComboThemes_SelectionChanged" Padding="6" Margin="0,0,0,15">
                                <ComboBoxItem Content="Светлый Оригинал"/>
                                <ComboBoxItem Content="Глубокая Ночь (Dark)"/>
                                <ComboBoxItem Content="Винтажная Сепия"/>
                                <ComboBoxItem Content="Киберпанк Неон"/>
                                <ComboBoxItem Content="Аниме Сакура (Розовый)"/>
                                <ComboBoxItem Content="Дракула Студио"/>
                                <ComboBoxItem Content="Глубокий Океан"/>
                                <ComboBoxItem Content="Лесной Мох"/>
                                <ComboBoxItem Content="Монохромный Минимализм"/>
                                <ComboBoxItem Content="Скрипт-Кидди (Терминал)"/>
                            </ComboBox>

                            <TextBlock Text="Кастомный Акцент" FontWeight="SemiBold" Margin="0,5,0,5" Foreground="{DynamicResource TextDefBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <Button Width="26" Height="26" Margin="2" Click="AccentChange_Click" Tag="#0078D4" Background="#0078D4" BorderThickness="0"/>
                                <Button Width="26" Height="26" Margin="2" Click="AccentChange_Click" Tag="#E81123" Background="#E81123" BorderThickness="0"/>
                                <Button Width="26" Height="26" Margin="2" Click="AccentChange_Click" Tag="#107C41" Background="#107C41" BorderThickness="0"/>
                                <Button Width="26" Height="26" Margin="2" Click="AccentChange_Click" Tag="#8660A9" Background="#8660A9" BorderThickness="0"/>
                                <Button Width="26" Height="26" Margin="2" Click="AccentChange_Click" Tag="#FF8C00" Background="#FF8C00" BorderThickness="0"/>
                                <Button Width="26" Height="26" Margin="2" Click="AccentChange_Click" Tag="#FF69B4" Background="#FF69B4" BorderThickness="0"/>
                            </StackPanel>

                            <TextBlock Text="Шрифт редактора" FontWeight="SemiBold" Margin="0,5,0,5" Foreground="{DynamicResource TextDefBrush}"/>
                            <ComboBox x:Name="comboFonts" SelectedIndex="0" SelectionChanged="ComboFonts_SelectionChanged" Padding="5" Margin="0,0,0,15">
                                <ComboBoxItem Content="Consolas"/>
                                <ComboBoxItem Content="Segoe UI"/>
                                <ComboBoxItem Content="Courier New"/>
                                <ComboBoxItem Content="Georgia"/>
                            </ComboBox>

                            <TextBlock Text="Размер Текста" FontWeight="SemiBold" Margin="0,5,0,5" Foreground="{DynamicResource TextDefBrush}"/>
                            <Slider x:Name="sliderFontSize" Minimum="10" Maximum="40" Value="16" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderFontSize_ValueChanged" Margin="0,0,0,15"/>

                            <Separator Margin="0,5"/>
                            <CheckBox x:Name="chkShowLineNumbers" Content="Номера строк" IsChecked="True" Checked="UIOptions_Changed" Unchecked="UIOptions_Changed" Margin="0,5" Foreground="{DynamicResource TextDefBrush}"/>
                            <CheckBox x:Name="chkWordWrap" Content="Перенос строк" IsChecked="False" Checked="UIOptions_Changed" Unchecked="UIOptions_Changed" Margin="0,5" Foreground="{DynamicResource TextDefBrush}"/>
                            <CheckBox x:Name="chkHighlightActiveLine" Content="Выделять контур окон" IsChecked="True" Checked="UIOptions_Changed" Unchecked="UIOptions_Changed" Margin="0,5" Foreground="{DynamicResource TextDefBrush}"/>

                            <Button Content="Сбросить UI" Margin="0,15,0,0" Click="ResetSettings_Click" Padding="5"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- НЕОЖИДАННАЯ ВКЛАДКА: СТЕГАНОГРАФИЯ (ШИФРОВАНИЕ В ФОТОГРАФИИ) -->
                <TabItem Header="Магия Маскировки">
                    <ScrollViewer Padding="12">
                        <StackPanel>
                            <TextBlock Text="ШИФРОВАНИЕ ТЕКСТА В КАРТИНКУ" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource TextDefBrush}"/>
                            <TextBlock Text="Вы можете спрятать весь текст текущей вкладки внутрь PNG изображения." FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="Gray"/>

                            <Button Content="Выбрать исходную картинку" Click="Stegano_SelectImage_Click" Padding="6" Margin="0,5"/>
                            <TextBlock x:Name="lblSteganoImgPath" Text="Файл не выбран" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,10" Foreground="DimGray"/>

                            <Button Content="Зашить текст и сохранить PNG" Click="Stegano_Encode_Click" Padding="6" Background="{DynamicResource AccentColor}" Foreground="White" BorderThickness="0" Margin="0,5"/>
                            <Separator Margin="0,10"/>
                            <Button Content="Извлечь текст из картинки" Click="Stegano_Decode_Click" Padding="6" Margin="0,5"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ЦЕНТРАЛЬНЫЙ ТАБ-КОНТРОЛЛЕР -->
        <TabControl x:Name="tabControlFiles" Background="{DynamicResource EditorBgBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrushDef}" SelectionChanged="TabControlFiles_SelectionChanged">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="26">
                        <TextBlock Text="📝" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding HeaderText}" Foreground="{DynamicResource TextDefBrush}" VerticalAlignment="Center" FontSize="13" Margin="0,0,10,0"/>
                        <Button Content="✕" Width="16" Height="16" FontSize="8" FontWeight="Bold" Click="CloseTab_Click" Background="Transparent" BorderThickness="0" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>
    </DockPanel>
</Window>