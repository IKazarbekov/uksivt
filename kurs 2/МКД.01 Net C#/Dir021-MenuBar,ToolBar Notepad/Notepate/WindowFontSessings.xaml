<Window x:Class="Notepate.WindowFontSessings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Notepate"
        mc:Ignorable="d"
        Title="Выберите шрифт" Height="450" Width="800"
        Icon="/images/icon.jpg">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <CheckBox/>
            <TextBlock Text=" Только шрифты программирования"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Шрифт: "/>
            <ComboBox/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Размер: "/>

        </StackPanel>
        <StackPanel Orientation="Horizontal">

        </StackPanel>
    </StackPanel>
</Window>
