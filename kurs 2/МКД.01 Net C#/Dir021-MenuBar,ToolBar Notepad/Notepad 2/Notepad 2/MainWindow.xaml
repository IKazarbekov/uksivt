<Window x:Class="Notepad_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Notepad_2"
        mc:Ignorable="d"
        Title="FeatherPad Pro" Height="700" Width="1100"
        MinHeight="500" MinWidth="700"
        Icon="/images/icon.jpg"
        Closing="Window_Closing"
        Background="#F5F5F7">

    <Window.Resources>
        <Style x:Key="buttonInToolBar" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CloseTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF4D4D"/>
                    <Setter Property="Background" Value="#FFEEFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" FontSize="14" Background="#FFFFFF" Padding="5,2">
            <MenuItem Header="Файл">
                <MenuItem Header="Новый" Command="ApplicationCommands.New" Click="Button_Click_New_File" InputGestureText="Ctrl+N"/>
                <MenuItem Header="Открыть" Command="ApplicationCommands.Open" Click="Button_Click_Open_File" InputGestureText="Ctrl+O"/>
                <MenuItem Header="Боковая панель" Click="Click_Left_Panel_Items" InputGestureText="F9"/>
                <Separator/>
                <MenuItem Header="Вынести вкладку" Click="Click_Take_Out_Item"/>
                <MenuItem Header="Следующая вкладка" Click="Click_To_Before_Item" InputGestureText="Ctrl+PageDown"/>
                <MenuItem Header="Предыдущая вкладка" Click="Click_To_Back_Item" InputGestureText="Ctrl+PageUp"/>
                <MenuItem Header="Первая вкладка" Click="Click_To_First_Item"/>
                <MenuItem Header="Последняя вкладка" Click="Click_To_End_Item"/>
                <Separator/>
                <MenuItem Header="Обновить (Перечитать с диска)" Click="Button_Click_Update_File" InputGestureText="F5"/>
                <Separator/>
                <MenuItem Header="Сохранить" Command="ApplicationCommands.Save" Click="Button_Click_Save_File" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Сохранить как..." Click="Button_Click_Save_File_As" InputGestureText="Ctrl+Shift+S"/>
                <MenuItem Header="Сохранить всё" Click="MenuItem_SaveAll_Click"/>
                <Separator/>
                <MenuItem Header="Печать..." Command="ApplicationCommands.Print" Click="Button_Click_Print" InputGestureText="Ctrl+P"/>
                <Separator/>
                <MenuItem Header="Закрыть вкладку" Click="Button_Click_Close" InputGestureText="Ctrl+W"/>
                <MenuItem Header="Выйти" Click="MenuItem_Exit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>

            <MenuItem Header="Правка">
                <MenuItem Header="Отменить" Command="ApplicationCommands.Undo" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="Повторить" Command="ApplicationCommands.Redo" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="Вырезать" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X"/>
                <MenuItem Header="Копировать" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"/>
                <MenuItem Header="Вставить" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V"/>
                <MenuItem Header="Удалить" Command="ApplicationCommands.Delete"/>
                <Separator/>
                <MenuItem Header="Преобразовать регистр">
                    <MenuItem Header="В верхний регистр (UPPERCASE)" Click="MenuItem_Uppercase_Click" InputGestureText="Ctrl+U"/>
                    <MenuItem Header="В нижний регистр (lowercase)" Click="MenuItem_Lowercase_Click" InputGestureText="Ctrl+L"/>
                </MenuItem>
                <MenuItem Header="Удалить пустые строки" Click="MenuItem_RemoveEmptyLines_Click"/>
                <MenuItem Header="Сортировать строки (А-Я)" Click="MenuItem_SortLines_Click"/>
                <Separator/>
                <MenuItem Header="Вставить дату и время" Click="MenuItem_InsertDateTime_Click" InputGestureText="F7"/>
            </MenuItem>

            <MenuItem Header="Параметры">
                <MenuItem Header="Отображение номеров строк" x:Name="menuShowLineNumbers" IsCheckable="True" IsChecked="True" Checked="LineNumbers_Toggle" Unchecked="LineNumbers_Toggle"/>
                <MenuItem Header="Перенос строк" x:Name="menuWordWrap" IsCheckable="True" IsChecked="False" Checked="WordWrap_Toggle" Unchecked="WordWrap_Toggle"/>
                <Separator/>
                <MenuItem Header="Кодировка по умолчанию">
                    <RadioButton x:Name="rbUTF8" Content="UTF-8" IsChecked="True" Click="Encoding_Changed"/>
                    <RadioButton x:Name="rbASCII" Content="ASCII" Click="Encoding_Changed"/>
                    <RadioButton x:Name="rbUnicode" Content="Unicode (UTF-16)" Click="Encoding_Changed"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Тема оформления">
                    <MenuItem Header="Светлая (Классическая)" Click="Theme_Light_Click"/>
                    <MenuItem Header="Тёмная (Ночная)" Click="Theme_Dark_Click"/>
                </MenuItem>
                <MenuItem Header="Шрифт..." Click="MenuItem_Click_OpenFontSettings"/>
            </MenuItem>

            <MenuItem Header="Поиск">
                <MenuItem Header="Найти..." Command="ApplicationCommands.Find" InputGestureText="Ctrl+F"/>
                <MenuItem Header="Заменить..." Command="ApplicationCommands.Replace" InputGestureText="Ctrl+H"/>
            </MenuItem>

            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Click="Button_Click_Help" InputGestureText="F1"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top" Background="#F0F0F2">
            <ToolBar Background="#F0F0F2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Button Style="{StaticResource buttonInToolBar}" Click="Button_Click_New_File" ToolTip="Новый файл (Ctrl+N)">
                    <Image Source="/images/new_file.jpg"/>
                </Button>
                <Button Style="{StaticResource buttonInToolBar}" Click="Button_Click_Open_File" ToolTip="Открыть файл (Ctrl+O)">
                    <Image Source="/images/open_file.jpg"/>
                </Button>
                <Button Style="{StaticResource buttonInToolBar}" Click="Button_Click_Save_File" ToolTip="Сохранить (Ctrl+S)">
                    <Image Source="/images/save_file.jpg"/>
                </Button>
                <Separator/>
                <Button Style="{StaticResource buttonInToolBar}" Command="ApplicationCommands.Undo" ToolTip="Отменить (Ctrl+Z)">
                    <Image Source="/images/undo.jpg"/>
                </Button>
                <Button Style="{StaticResource buttonInToolBar}" Command="ApplicationCommands.Redo" ToolTip="Повторить (Ctrl+Y)">
                    <Image Source="/images/redo.jpg"/>
                </Button>
                <Button Style="{StaticResource buttonInToolBar}" Click="Button_Click_Update_File" ToolTip="Обновить файл">
                    <Image Source="/images/update.jpg"/>
                </Button>
                <Separator/>
                <Button Style="{StaticResource buttonInToolBar}" Command="ApplicationCommands.Find" ToolTip="Панель поиска (Ctrl+F)">
                    <Image Source="/images/PanelSearch.jpg"/>
                </Button>
                <Button Style="{StaticResource buttonInToolBar}" Command="ApplicationCommands.Replace" ToolTip="Панель замены (Ctrl+H)">
                    <Image Source="/images/PanekZamena.jpg"/>
                </Button>
                <Separator/>
                <Button Style="{StaticResource buttonInToolBar}" Click="Click_Left_Panel_Items" ToolTip="Боковая панель (F9)">
                    <Image Source="/images/Panel_Bok.jpg"/>
                </Button>
                <Button Style="{StaticResource buttonInToolBar}" Click="Button_Click_Print" ToolTip="Печать документа (Ctrl+P)">
                    <Image Source="/images/Seans.jpg"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom" Background="#EFEFEF" Foreground="#333333" Padding="5,2">
            <StatusBarItem>
                <TextBlock x:Name="textBlockInfo" FontSize="12" Text="Готово" Width="250"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="lblLinesCount" FontSize="12" Text="Строк: 1"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="lblCharCount" FontSize="12" Text="Символов: 0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="lblEncoding" FontSize="12" Text="Кодировка: UTF-8"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="lblZoom" FontSize="12" Text="Масштаб: 100%"/>
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Height="45" Visibility="Collapsed" x:Name="SearchPanel">
            <DockPanel LastChildFill="True" Margin="10,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="buttonFindNext" Margin="2" Padding="5" Click="buttonFindNext_Click" ToolTip="Найти далее">
                        <Image Source="/images/FindNext.png" Width="16" Height="16"/>
                    </Button>
                    <Button x:Name="buttonFindBack" Margin="2" Padding="5" Click="buttonFindBack_Click" ToolTip="Найти ранее">
                        <Image Source="/images/FindBack.jpg" Width="16" Height="16"/>
                    </Button>
                    <ToggleButton x:Name="buttonWithCase" Content="Aa" Width="35" Margin="2" ToolTip="Учитывать регистр" FontWeight="Bold"/>
                    <ToggleButton x:Name="buttonRegex" Content=".*" Width="35" Margin="2" ToolTip="Регулярные выражения" FontFamily="Consolas"/>
                    <Button Content="✕" Width="25" Margin="5,2" Background="Transparent" BorderThickness="0" FontWeight="Bold" Click="CloseSearchPanel_Click"/>
                </StackPanel>
                <TextBlock Text="Найти:" VerticalAlignment="Center" Margin="5,0,10,0" FontSize="13" Foreground="#333333"/>
                <TextBox x:Name="textBoxFind" Style="{StaticResource ModernTextBox}" Height="26" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="10" Visibility="Collapsed" x:Name="ReplacePanel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Найти:" VerticalAlignment="Center" Width="90" FontSize="13"/>
                <TextBox Grid.Column="1" x:Name="textBoxReplaceFind" Style="{StaticResource ModernTextBox}" Height="26" Margin="0,2"/>

                <TextBlock Grid.Row="1" Text="Заменить на:" VerticalAlignment="Center" Width="90" FontSize="13"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="textBoxReplaceText" Style="{StaticResource ModernTextBox}" Height="26" Margin="0,2"/>

                <Button Grid.Column="2" Grid.Row="0" Margin="5,2,0,2" Padding="10,2" Content="Найти далее" Click="Button_FindNext_ReplacePanel_Click"/>
                <Button Grid.Column="2" Grid.Row="1" Margin="5,2,0,2" Padding="10,2" Content="Заменить" Click="Button_Replace_Click"/>
                <Button Grid.Column="3" Grid.Row="1" Margin="5,2,0,2" Padding="10,2" Content="Заменить всё" Click="Button_ReplaceAll_Click"/>
                <Button Grid.Column="3" Grid.Row="0" Content="✕" Width="25" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontWeight="Bold" Click="CloseReplacePanel_Click"/>
            </Grid>
        </Border>

        <Border x:Name="LeftSidebar" Width="200" Background="#F0F0F2" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" DockPanel.Dock="Left" Visibility="Visible">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="ОТКРЫТЫЕ ЛИСТЫ" Margin="10" FontWeight="Bold" FontSize="11" Foreground="#666666"/>
                <ListBox Grid.Row="1" x:Name="lstSidebarFiles" Background="Transparent" BorderThickness="0" DisplayMemberPath="HeaderText" SelectionChanged="LstSidebarFiles_SelectionChanged"/>
            </Grid>
        </Border>

        <TabControl x:Name="tabControlFiles" Background="#FFFFFF" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0" SelectionChanged="TabControlFiles_SelectionChanged">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/images/icon.png" Width="14" Height="14" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding HeaderText}" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource CloseTabButton}" Content="✕" Click="CloseTab_Click" ToolTip="Закрыть вкладку"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>
    </DockPanel>
</Window>