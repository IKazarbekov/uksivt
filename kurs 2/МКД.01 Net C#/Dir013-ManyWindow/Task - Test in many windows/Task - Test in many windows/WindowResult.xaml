<Window x:Class="Task___Test_in_many_windows.WindowResult"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task___Test_in_many_windows"
        mc:Ignorable="d"
        Title="WindowResult" Height="450" Width="800"
        Closing="Window_Closed">
    <DockPanel LastChildFill="True"
               Margin="20">
        
        <DockPanel DockPanel.Dock="Top"
                   Margin="20"
                   LastChildFill="True">
            <TextBlock Text="Name"
                       x:Name="textBlockName"
                       FontSize="30"
                       DockPanel.Dock="Left"
                       />
            <TextBlock Text="Ваш результат: 10"
                       x:Name="textBlockResult"
                       FontSize="30"
                       DockPanel.Dock="Right"
                       />
            <Separator/>
        </DockPanel>

        <DockPanel>
            <TextBlock Text="Результат других игроков"
                       DockPanel.Dock="Top"
                       FontSize="30"
                       TextAlignment="Center"/>
            <Button Content="Выйти"
                    DockPanel.Dock="Right"
                    Width="100"
                    Height="70"
                    Margin="10"
                    VerticalAlignment="Bottom" Click="Button_Click"/>
            <Separator DockPanel.Dock="Left"
                       Width="100"
                       Visibility="Hidden"/>
            <DataGrid x:Name="dataGridStatistic"
                  Margin="20 5"
                      HorizontalAlignment="Center"
                      Width="500">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Участник" Binding="{Binding Key}"/>
                    <DataGridTextColumn Header="Балл" Binding="{Binding Value}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

    </DockPanel>
</Window>
