<Window x:Class="TestCanvas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestCanvas"
        mc:Ignorable="d"
        Title="Масштабирование с сохранением пропорций"
        WindowStyle="None" MouseDown="Window_MouseDown">
    <Window.Background>
        <ImageBrush ImageSource="/класс.jpg"/>
    </Window.Background>
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="GameCanvas" Width="400" Height="300">
            <!-- Ваше содержимое игры -->
            <Rectangle Canvas.Left="100" Canvas.Top="100"
                        Width="50" Height="50" Fill="Red"/>
            <Ellipse Canvas.Left="300" Canvas.Top="200"
                       Width="80" Height="80" Fill="Blue"/>
            <Button Content="Hello"
                    Canvas.Left="200" Canvas.Top="250"
                    Width="100" Height="30"/>
        </Canvas>
    </Viewbox>
</Window>
