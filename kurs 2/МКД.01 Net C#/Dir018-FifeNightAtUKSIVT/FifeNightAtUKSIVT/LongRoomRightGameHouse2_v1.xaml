<Window x:Class="FifeNightAtUKSIVT.LongRoomRightGameHouse2_v1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FifeNightAtUKSIVT"
        mc:Ignorable="d"
        Title="Game_House2_v1" Height="450" Width="800"
        WindowStyle="None" Background="Black"
        WindowState="Maximized">
    <DockPanel>
        <DockPanel.Background>
            <ImageBrush 
                x:Name="mainImageBrush"
                ImageSource="/images/LongDoorRight.jpg"/>
        </DockPanel.Background>

        <Grid x:Name="ContanerAtNotebook">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="163*"/>
                <ColumnDefinition Width="637*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="142*"/>
                <RowDefinition Height="83*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="1"
                Content="Назад"
                FontSize="150"
                Background="Transparent" Grid.Column="0" Click="ButtonBack_Click"
                />

        </Grid>

    </DockPanel>
</Window>
