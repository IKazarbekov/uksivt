<Window x:Class="FifeNightAtUKSIVT.LongRoomLeftGameHouse2_v1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FifeNightAtUKSIVT"
        mc:Ignorable="d"
                        Title="Game_House2_v1" Height="450" Width="800"
        WindowStyle="None"
        WindowState="Maximized"
        KeyUp="Button_KeyUp"
        KeyDown="Button_KeyDown">
    <Window.Background>
        <ImageBrush ImageSource="/images/LongDoorLeft.jpg"/>
    </Window.Background>
    <DockPanel>
        <DockPanel.Background>
            <ImageBrush 
                x:Name="mainImageBrush"
                
                ImageSource="/images/LongDoorLeftBlack.jpg" Stretch="Fill"/>
        </DockPanel.Background>

        <Grid x:Name="ContanerAtNotebook">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="107*"/>
                <ColumnDefinition Width="56*"/>
                <ColumnDefinition Width="63*"/>
                <ColumnDefinition Width="78*"/>
                <ColumnDefinition Width="131*"/>
                <ColumnDefinition Width="167*"/>
                <ColumnDefinition Width="198*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="34*"/>
                <RowDefinition Height="108*"/>
                <RowDefinition Height="34*"/>
                <RowDefinition Height="49*"/>
            </Grid.RowDefinitions>
            <Button
                Grid.Column="6" Grid.Row="3"
                Content="Направо"
                FontSize="100"
                Margin="0,1,0,0"
                Background="Transparent"
                Click="ButtonDoLeft_Click"
                >

            </Button>

            <Button Grid.Row="3"
                Content="Назад"
                FontSize="100"
                Background="Transparent" Grid.Column="0" Click="ButtonBack_Click" Grid.ColumnSpan="2"
                />

            <Image Source="/images/MenIlyasv1.jpg.jpg"
                   Grid.Column="1" Grid.ColumnSpan="2"
                   Grid.Row="1" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-16.902"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

        </Grid>

    </DockPanel>
</Window>