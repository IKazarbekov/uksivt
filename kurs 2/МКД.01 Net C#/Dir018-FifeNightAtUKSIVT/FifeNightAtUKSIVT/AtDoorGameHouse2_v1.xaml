<Window x:Class="FifeNightAtUKSIVT.AtDoorGameHouse2_v1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FifeNightAtUKSIVT"
        mc:Ignorable="d"
                Title="Game_House2_v1" Height="450" Width="800"
        WindowStyle="None" Background="Black"
        WindowState="Maximized">
    <DockPanel>
        <DockPanel.Background>
            <ImageBrush 
                x:Name="mainImageBrush"
                ImageSource="/images/AtDoor.jpg"/>
        </DockPanel.Background>

        <Grid x:Name="ContanerAtNotebook">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="98*"/>
                <ColumnDefinition Width="152*"/>
                <ColumnDefinition Width="83*"/>
                <ColumnDefinition Width="393*"/>
                <ColumnDefinition Width="74*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="204*"/>
                <RowDefinition Height="99*"/>
                <RowDefinition Height="116*"/>
                <RowDefinition Height="31*"/>
            </Grid.RowDefinitions>
            <Button
                Grid.Column="3" Grid.Row="2"
                Content="Назад"
                FontSize="15"
                Margin="0,1,0,0"
                Background="Transparent"
                Click="ButtonGoAtNotebook_Click" Grid.ColumnSpan="2" Grid.RowSpan="2"
                >

            </Button>

            <Button
                Grid.Column="1" Grid.Row="1"
                FontSize="25"
                Background="Transparent" Grid.RowSpan="2" Click="Button_Click"
                >

            </Button>

        </Grid>

    </DockPanel>
</Window>
