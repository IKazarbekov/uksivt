<Window x:Class="FifeNightAtUKSIVT.Game_House2_v1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FifeNightAtUKSIVT"
        mc:Ignorable="d"
        Title="Game_House2_v1" Height="450" Width="800"
        WindowStyle="None" Background="Black"
        WindowState="Maximized">
    <DockPanel>
        <DockPanel.Background>
            <ImageBrush 
                x:Name="mainImageBrush"
                ImageSource="/images/AtNotebookV2.jpg"/>
        </DockPanel.Background>

        <Grid x:Name="ContanerAtNotebook">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="254*"/>
                <ColumnDefinition Width="282*"/>
                <ColumnDefinition Width="161*"/>
                <ColumnDefinition Width="103*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="204*"/>
                <RowDefinition Height="227*"/>
                <RowDefinition Height="19*"/>
            </Grid.RowDefinitions>
            <Button
                Grid.Column="3" Grid.Row="0"
                Content="В коридор"
                FontSize="15"
                Margin="0,1,0,0"
                Background="Transparent"
                MouseEnter="ButtonGoAtDoor_Click"
                >

            </Button>

            <Button
                Grid.Column="1" Grid.Row="1"
                FontSize="25"
                Background="Transparent" Click="ButtonGoInNotebook_Click"
                >

            </Button>

        </Grid>

    </DockPanel>
</Window>
