<Window x:Class="FifeNightAtUKSIVT.CameraLongRoomLeft"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FifeNightAtUKSIVT"
        mc:Ignorable="d"
        Title="Game_House2_v1" Height="300" Width="400"
        Background="Black" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <DockPanel.Background>
            <ImageBrush 
                x:Name="mainImageBrush"
                ImageSource="/images/CameraLongRoomRight.jpg"/>
        </DockPanel.Background>

        <Grid x:Name="ContanerAtNotebook">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="21*"/>
                <ColumnDefinition Width="19*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="374*"/>
                <RowDefinition Height="57*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="1"
                Content="Выйти"
                FontSize="25"
                Background="Transparent" 
                
                />
        </Grid>

    </DockPanel>
</Window>
