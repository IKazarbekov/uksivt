<Window x:Class="FifeNightAtUKSIVT.AtPenDoorGameHouse2_v1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FifeNightAtUKSIVT"
        mc:Ignorable="d"
                Title="Game_House2_v1" Height="450" Width="800"
        WindowStyle="None" Background="Black"
        WindowState="Maximized">
    <DockPanel>
        <DockPanel.Background>
            <ImageBrush 
                x:Name="mainImageBrush"
                ImageSource="/images/AtPenDoorO1.jpg"/>
        </DockPanel.Background>

        <Grid x:Name="ContanerAtNotebook">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252*"/>
                <ColumnDefinition Width="271*"/>
                <ColumnDefinition Width="277*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="83*"/>
                <RowDefinition Height="59*"/>
                <RowDefinition Height="83*"/>
            </Grid.RowDefinitions>
            <Button
                Grid.Column="0" Grid.Row="0"
                Content="Открыть"
                FontSize="150"
                Margin="0,1,0,0"
                Background="Transparent"
                Click="ButtonOpenDoor_Click"
                >

            </Button>

            <Button Grid.Row="2"
                Content="Закрыть"
                FontSize="150"
                Background="Transparent" Grid.Column="0" Click="ButtonCloseDoor_Click"
                />

            <Button
                Grid.Column="2" Grid.Row="2"
                Content="Назад"
                FontSize="150"
                Margin="0,1,0,0"
                Background="Transparent"
                Click="ButtonBack_Click"
                >

            </Button>

        </Grid>

    </DockPanel>
</Window>
