<Window x:Class="Task.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task"
        mc:Ignorable="d"
        Title="Магазин обуви!" Height="800" Width="1000"
        MinHeight="800" MinWidth="1000" Icon="/images/1.png" Background="AliceBlue">
    <UniformGrid Rows="3">
        <DataGrid x:Name="dataGrid"
                  ItemsSource="{Binding}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Фото" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Image}" Height="100" Margin="10"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Описание" Width="*">
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate>
                            <StackPanel Margin="10">
                                <TextBlock Text="{Binding NameAndCategory}" FontSize="20"/>
                                <Separator Height="10" Visibility="Hidden"/>
                                <TextBlock Text="{Binding DescriptionStr}"/>
                                <TextBlock Text="{Binding PriceStr}"/>
                                <TextBlock Text="{Binding CountStr}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Скидка" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="{Binding Color}" Margin="10" Width="100">
                                <TextBlock Text="{Binding Discount}" Foreground="Black" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <ListView ItemsSource="{Binding}" HorizontalContentAlignment="Stretch" Margin="10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <Separator Grid.Column="1" Width="5"/>
                        <Separator Grid.Column="3" Width="5"/>
                        <Image Grid.Column="0" Source="{Binding Image}" Height="100"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock>
                                    Категория товара|Наименование товара
                            </TextBlock>
                            <Separator Height="10"/>
                            <TextBlock Text="{Binding DescriptionStr}"/>
                            <TextBlock Text="{Binding PriceStr}"/>
                            <TextBlock Text="{Binding CountStr}"/>
                        </StackPanel>
                        <Grid Background="{Binding Color}" Grid.Column="4">
                            <TextBlock Text="{Binding Discount}" Foreground="Black" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <local:UserControl1 Margin="10"/>
    </UniformGrid>
</Window>
