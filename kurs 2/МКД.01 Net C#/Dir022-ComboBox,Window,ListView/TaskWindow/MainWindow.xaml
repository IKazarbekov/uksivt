<Window x:Class="TaskWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="400"
        AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" MouseDown="Window_MouseDown">
    <Window.Resources>
        <BitmapImage x:Key="nano" UriSource="images/nano.png"/>
        <BitmapImage x:Key="uno" UriSource="images/uno.png"/>
        <BitmapImage x:Key="mini" UriSource="images/mini.png"/>
        <BitmapImage x:Key="mega" UriSource="images/mega.png"/>
    </Window.Resources>
    <StackPanel>
        <Image x:Name="image" Source="/images/nano.png"/>
        <TextBox x:Name="textBox" Width="200"/>
        <Button x:Name="myButton" Content="Проверить имя" Width="200" Click="Button_Click"/>
    </StackPanel>
</Window>
