<Window x:Class="TaskListBoxPhones.WindowAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskListBoxPhones"
        mc:Ignorable="d"
        Title="Добавить телефон" Height="200" Width="400">
    <StackPanel>
        <TextBlock Text="Модель"/>
        <TextBox x:Name="textBoxModel"/>
        <TextBlock Text="Производительность"/>
        <TextBox x:Name="textBoxOpt"/>
        <TextBlock Text="Стоит(руб)"/>
        <TextBox x:Name="textBoxPrice"/>
        <Button Click="Button_Click" Content="Добавить"/>
    </StackPanel>
</Window>
