<Window x:Class="РЕГИСТРАЦИЯ_НА_МАРАФОН.WindowRegistration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:РЕГИСТРАЦИЯ_НА_МАРАФОН"
        mc:Ignorable="d"
        Style="{StaticResource MainWindowStyle}" Height="600" Width="900"
        MinHeight="600" MinWidth="900">
    <DockPanel>
        <local:TopPanel DockPanel.Dock="Top" Click="TopPanel_Click"/>
        <local:BottomPanel DockPanel.Dock="Bottom"/>
        <StackPanel>
            <TextBlock Text="Регистрация бегуна"
                       x:Name="textBlockTitle"
                       FontSize="30"
                       TextAlignment="Center"
                       Margin="10"/>
            <TextBlock Text="Пожалуйста заполнеите всю информацию, чтобы зарегистрироватся в качестве бегуна"
                       FontSize="15"
                       TextAlignment="Center"/>
            <UniformGrid Columns="2" Margin="10">
                <UniformGrid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="20"/>
                        <Setter Property="TextAlignment" Value="Right"/>
                        <Setter Property="Margin" Value="5"/>
                    </Style>
                    <Style TargetType="local:PlaceholderTextBox">
                        <Setter Property="Margin" Value="5"/>
                    </Style>
                </UniformGrid.Resources>
                <UniformGrid Columns="2" Rows="6">
                    <TextBlock Text="Email:"/>
                    <local:PlaceholderTextBox Placeholder="Email"
                                              x:Name="textBoxEmail"/>
                    <TextBlock Text="Пароль:"/>
                    <local:PlaceholderTextBox Placeholder="Пароль"
                                              x:Name="textBoxFirstPassword"/>
                    <TextBlock Text="Повторите пароль:"/>
                    <local:PlaceholderTextBox Placeholder="Повторите пароль"
                                              x:Name="textBoxSecondPassword"/>
                    <TextBlock Text="Имя:"/>
                    <local:PlaceholderTextBox Placeholder="Имя"
                                              x:Name="textBoxFirstName"/>
                    <TextBlock Text="Фамилия:"/>
                    <local:PlaceholderTextBox Placeholder="Фамилия"
                                              x:Name="textBoxSecondName"/>
                    <TextBlock Text="Пол:"/>
                    <ComboBox x:Name="comboBoxGender" Margin="10" SelectedIndex="0">
                        <ComboBoxItem>Мужской</ComboBoxItem>
                        <ComboBoxItem>Женский</ComboBoxItem>
                    </ComboBox>
                </UniformGrid>
                <Canvas>
                    <Grid Height="100" Width="110"
                          Background="LightGray"
                          HorizontalAlignment="Left" Canvas.Left="217" VerticalAlignment="Center" Canvas.Top="7">
                        <TextBlock Text="Фото"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"/>
                        <Image x:Name="image"/>
                    </Grid>
                    <TextBlock Canvas.Left="20" TextWrapping="Wrap" Canvas.Top="94" Text="Фото файл:"
                               FontSize="15" HorizontalAlignment="Left" VerticalAlignment="Top" Height="18" Width="79"/>
                    <local:PlaceholderTextBox Canvas.Left="15" Canvas.Top="112" HorizontalAlignment="Center" VerticalAlignment="Top" 
                                              Width="180" Height="21" Placeholder="Photo_logo.jpg"
                                              x:Name="textBoxImage"/>
                    <local:RoundButton Canvas.Left="205" Canvas.Top="105" HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" Width="134" Height="47" Text="Просмотр"
                                       Click="RoundButtonPhoto_Click"/>
                    <TextBlock Canvas.Left="20" TextWrapping="Wrap" Canvas.Top="163" Text="Дата рождения: "
                        FontSize="15" Height="18" Width="124" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <DatePicker Canvas.Left="154" Canvas.Top="167" HorizontalAlignment="Left" VerticalAlignment="Top" Width="168" x:Name="dateTimePicker"/>
                    <TextBlock Canvas.Left="10" TextWrapping="Wrap" Canvas.Top="205" Text="Страна: "
                        FontSize="15" Height="18" Width="124" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <ComboBox Canvas.Left="154" Canvas.Top="211" HorizontalAlignment="Left" VerticalAlignment="Top" Width="168"
                              x:Name="comboBoxCountry" SelectedIndex="0">
                        <ComboBoxItem Content="Россия"/>
                        <ComboBoxItem Content="Беларусь"/>
                        <ComboBoxItem Content="Казахстан"/>
                        <ComboBoxItem Content="Узбекистан"/>
                        <ComboBoxItem Content="Азербайджан"/>
                        <ComboBoxItem Content="Армения"/>
                        <ComboBoxItem Content="Кыргызстан"/>
                        <ComboBoxItem Content="Таджикистан"/>
                        <ComboBoxItem Content="Туркменистан"/>
                        <ComboBoxItem Content="Молдова"/>
                    </ComboBox>
                </Canvas>
            </UniformGrid>
            <TextBlock Foreground="Red" x:Name="textBlockError" Text="error" TextAlignment="Center" FontSize="15" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        >
                <local:RoundButton Text="Регистрация" Width="100" Height="50"
                                   Click="RoundButton_Click"/>
                <local:RoundButton Text="Отмена" Click="TopPanel_Click"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
