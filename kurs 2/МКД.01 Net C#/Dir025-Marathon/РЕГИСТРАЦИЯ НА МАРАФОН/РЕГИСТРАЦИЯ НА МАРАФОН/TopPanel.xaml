<UserControl x:Class="РЕГИСТРАЦИЯ_НА_МАРАФОН.TopPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:РЕГИСТРАЦИЯ_НА_МАРАФОН"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
	<DockPanel Background="{StaticResource PanelColor}"
                Height="60"
                >
        <local:RoundButton x:Name="buttonExit" Text="Назад" Width="100" FontSize="19" DockPanel.Dock="Left"/>
        <local:RoundButton x:Name="buttonLogout" Text="logout" Width="100" FontSize="19" DockPanel.Dock="Right" Visibility="Collapsed"/>
        <TextBlock Text="MARATHON SKILLS 2016"
                       Style="{StaticResource textBlockMainTitle}"
                       TextAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="25"
                       />
    </DockPanel>
</UserControl>
