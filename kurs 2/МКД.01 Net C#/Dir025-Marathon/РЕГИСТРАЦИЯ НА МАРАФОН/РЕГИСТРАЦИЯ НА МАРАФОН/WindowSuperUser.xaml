<Window x:Class="РЕГИСТРАЦИЯ_НА_МАРАФОН.WindowSuperUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:РЕГИСТРАЦИЯ_НА_МАРАФОН"
        mc:Ignorable="d"
        Style="{StaticResource MainWindowStyle}" Height="600" Width="800"
        MinHeight="600" MinWidth="800">
    <DockPanel>
        <local:BottomPanel DockPanel.Dock="Bottom"/>
        <local:TopPanel DockPanel.Dock="Top" Click="TopPanel_Click" ClickLogout="TopPanel_ClickLogout"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Управление пользователями" FontSize="30" Foreground="Gray" TextAlignment="Center" Margin="10"/>
                <UniformGrid Columns="2" Margin="50 0">
                    <local:RoundButton Click="RoundButtonAdd_Click" Text="+ Добавление пользователя" Width="298" Height="60" HorizontalAlignment="Left" FontSize="20"/>
                    <UniformGrid Rows="4" Columns="2">
                        <UniformGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="15"/>
                            </Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Background" Value="Black"/>
                                <Setter Property="Opacity" Value="0.7"/>
                                <Setter Property="FontSize" Value="20"/>
                            </Style>
                        </UniformGrid.Resources>
                        <TextBlock Text="Фильтр по ролям: " Margin="5"/>
                        <Grid Margin="5">
                            <TextBlock Margin="5" Text="Все роли" TextAlignment="Left" Foreground="Gray"/>
                            <ComboBox x:Name="comboBoxRole" SelectedValuePath="Content">
                                <ComboBoxItem>Бегун</ComboBoxItem>
                                <ComboBoxItem>Координатор</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                        <TextBlock Text="Сортировать по: "/>
                        <Grid Margin="5">
                            <TextBlock Margin="5" Text="Имени" TextAlignment="Left" Foreground="Gray"/>
                            <ComboBox x:Name="comboBoxSort" SelectedValuePath="Tag">
                                <ComboBoxItem Tag="FirstName">Имени</ComboBoxItem>
                                <ComboBoxItem Tag="LastName">Фамилии</ComboBoxItem>
                                <ComboBoxItem Tag="Email">Почте</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                        <TextBlock Text="Поиск: "/>
                        <Grid Margin="5">
                            <TextBlock Margin="5" Text="Поиск" TextAlignment="Left" Foreground="Gray"/>
                            <TextBox x:Name="textBoxFilter" FontSize="20" Opacity="0.7" Background="#FFF2F2F2"/>
                        </Grid>
                        <Grid/>
                        <local:RoundButton Click="RoundButtonSort_Click" Height="40" Width="100" HorizontalAlignment="Left" Text="Обновить"/>
                    </UniformGrid>
                </UniformGrid>
                <TextBlock Text="Всего пользователей: " Margin="60 10" FontSize="20" x:Name="textBlockCount"/>
            </StackPanel>
            <DataGrid Grid.Row="1" CanUserSortColumns="False" CanUserDeleteRows="False" IsReadOnly="True" CanUserResizeColumns="False" x:Name="dataGrid" AutoGenerateColumns="False" FontSize="25" Margin="50 0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FFA5A5A5"/>
                        <Setter Property="BorderBrush" Value="Black"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="5"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#FFF0F0F0"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="имя" Binding="{Binding FirstName}" Width="*"/>
                    <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*"/>
                    <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="*"/>
                    <DataGridTemplateColumn Header="">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <local:RoundButton Text="Edit" Margin="5 2" Click="RoundButtonEdit_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
