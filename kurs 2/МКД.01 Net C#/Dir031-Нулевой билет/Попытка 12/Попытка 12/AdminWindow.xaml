<Window x:Class="Попытка_12.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Попытка_12"
        mc:Ignorable="d"
        Title="AdminWindow" Height="450" Width="800" Closed="Window_Closed">
    <TabControl>
        <TabItem Header="Тренировки">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Треннер"/>
                    <TextBox x:Name="trenner" Width="100"/>
                    <TextBlock Text="  Тип"/>
                    <ComboBox x:Name="type" Width="100">
                        <ComboBoxItem>Отжимание</ComboBoxItem>
                        <ComboBoxItem>Бег</ComboBoxItem>
                        <ComboBoxItem>Плаванье</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="  Кол-во мест"/>
                    <TextBox x:Name="count" Width="100"/>
                    <DatePicker x:Name="date"/>
                    <Button Content="Добавить" Click="Button_Click"/>
                </StackPanel>
                <DataGrid x:Name="ViewLessons" CanUserAddRows="False"/>
            </StackPanel>
        </TabItem>
        <TabItem Header="Бронирование">
            <WrapPanel Orientation="Vertical">
                <DataGrid x:Name="lessonsForBroning"/>
                <DataGrid x:Name="users"/>
                <Button Content="Забронировать" Click="Button_Click_1"/>
                <DataGrid x:Name="brones"/>
            </WrapPanel>
        </TabItem>
    </TabControl>
</Window>
