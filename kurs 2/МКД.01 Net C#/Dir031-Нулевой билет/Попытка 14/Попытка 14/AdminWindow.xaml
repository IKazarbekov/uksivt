<Window x:Class="Попытка_14.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Попытка_14"
        mc:Ignorable="d"
        Height="450" Width="800" MinHeight="450" MinWidth="800" Style="{StaticResource window}" MouseDown="Window_MouseDown">
    <DockPanel Margin="2">
        <DockPanel DockPanel.Dock="Top">
            <Image Source="/1285748.png" Width="30" DockPanel.Dock="Left">
                <Image.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Width"
                                    To="100" Duration="0:0:2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Width"
                                    To="30" Duration="0:0:1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>
            <Label Content="Комнаты - администрирование"/>
            <Button Content="  X  " Background="Red" Click="Button_Click_Close" DockPanel.Dock="Right"/>
            <Button Content=" [ ] " Click="Button_Click_Size" DockPanel.Dock="Right"/>
            <Button Content="  -  " Click="Button_Click_Hidden" DockPanel.Dock="Right"/>
            <Button Content=" ->  " Click="Button_Click_Exit" DockPanel.Dock="Right" Background="Orange"/>
            <Grid/>
        </DockPanel>
        <TabControl Margin="0 20 0 0">
            <TabItem Header="Комнаты">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Width="200">
                        <Label Content="Добавление"/>
                        <TextBlock Text="Название"/>
                        <TextBox x:Name="name" TextChanged="name_TextChanged"/>
                        <TextBlock Text="Этаж" Margin="0 10 0 5" x:Name="atashText"/>
                        <Slider Minimum="1" Maximum="5" x:Name="atash" ValueChanged="atash_ValueChanged"/>
                        <TextBlock Text="Вместимость" Margin="0 10 0 5" x:Name="countText"/>
                        <Slider Minimum="1" Maximum="5" x:Name="count" ValueChanged="count_ValueChanged"/>
                        <TextBlock Text="Проектор" Margin="0 10 0 5"/>
                        <CheckBox x:Name="proector" Content="Имеется"/>
                        <Button Content="Добавить" Margin="0 20 0 5" x:Name="buttonRoom" Click="buttonRoom_Click" Width="110" Background="LightGreen"/>
                        <Button Content="Удалить" x:Name="buttonDeleteRoom" IsEnabled="False" Click="buttonDeleteRoom_Click" Width="100" Background="Orange"/>
                    </StackPanel>
                    <DataGrid x:Name="rooms" CanUserAddRows="False"
                              AutoGenerateColumns="False" CanUserReorderColumns="False"
                              SelectedCellsChanged="rooms_SelectedCellsChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Вместимость" Binding="{Binding Count}" Width="*"/>
                            <DataGridTextColumn Header="Этаж" Binding="{Binding Atash}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Проектор" Binding="{Binding Proector}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Брони">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Width="200">
                        <Label Content="Бронирование"/>
                        <TextBlock Text="Комната" Margin="0 20 0 0"/>
                        <ComboBox x:Name="cbRooms" SelectionChanged="cb_SelectionChanged" Background="Blue">
                            <ComboBox.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetProperty="Background.Color"
                                                To="Blue" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetProperty="Background.Color"
                                                To="AliceBlue" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ComboBox.Triggers>
                        </ComboBox>
                        <TextBlock Text="Пользователь" Margin="0 20 0 0"/>
                        <ComboBox x:Name="cbUsers" SelectionChanged="cb_SelectionChanged"/>
                        <Button Content="Бронировать" IsEnabled="False" Margin="0 20 0 0" x:Name="buttonBrone" Click="buttonBrone_Click" Width="140" Background="LightGreen"/>
                        <Button Content="Удалить" Margin=" 0 50 0 0" x:Name="buttonDeleteBrone" Width="100" Background="Orange" IsEnabled="False" Click="buttonDeleteBrone_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="brones" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserReorderColumns="False"
                              CanUserDeleteRows="False" SelectedCellsChanged="brones_SelectedCellsChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}"/>
                            <DataGridTextColumn Header="Комната" Binding="{Binding RoomName}"/>
                            <DataGridTextColumn Header="Дата бронирования" Binding="{Binding Date}"/>
                            <DataGridCheckBoxColumn Header="Подтверждение" Binding="{Binding Status}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Пользователи">
                <DataGrid x:Name="users">

                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
