<UserControl x:Class="Попытка_14.UserControlBrone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Попытка_14"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="10" Margin="10" Padding="10" Background="AliceBlue">
        <Border.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <ColorAnimation
                    Storyboard.TargetProperty="Background.Color"
                    To="LightPink" Duration="0:0:0.2"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <ColorAnimation
                    Storyboard.TargetProperty="Background.Color"
                    To="AliceBlue" Duration="0:0:0.2"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <DockPanel HorizontalAlignment="Stretch" Height="30">
            <TextBlock x:Name="roomName" DockPanel.Dock="Left"/>
            <TextBlock x:Name="accept" DockPanel.Dock="Right"/>
            <TextBlock x:Name="dateBrone" HorizontalAlignment="Center"/>
        </DockPanel>
    </Border>
</UserControl>
