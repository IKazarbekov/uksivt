<Window x:Class="Попытка_14.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Попытка_14"
        mc:Ignorable="d"
        Height="450" Width="800" MinHeight="450" MinWidth="800" Style="{Binding window}" WindowStyle="None" MouseDown="Window_MouseDown">
    <DockPanel Margin="2">
        <DockPanel DockPanel.Dock="Top">
            <Image Source="/1285748.png" Width="30" DockPanel.Dock="Left"/>
            <Label Content="Комнаты - просмотр броней"/>
            <Button Content="  X  " Background="Red" Click="Button_Click_Close" DockPanel.Dock="Right"/>
            <Button Content=" [ ] " Click="Button_Click_Size" DockPanel.Dock="Right"/>
            <Button Content="  -  " Click="Button_Click_Hidden" DockPanel.Dock="Right"/>
            <Button Content=" ->  " Click="Button_Click_Exit" DockPanel.Dock="Right" Background="Orange"/>
            <Grid/>
        </DockPanel>
        <ScrollViewer>
            <StackPanel x:Name="list" Margin="20">

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
