<Window x:Class="Попытка_14.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Попытка_14"
        mc:Ignorable="d"
        Title="MainWindow" Height="300" Width="300" Style="{StaticResource window}" WindowStartupLocation="CenterScreen" MouseDown="Window_MouseDown" ResizeMode="NoResize">

    <DockPanel Margin="1">
        <DockPanel DockPanel.Dock="Top">
            <Image Source="/1285748.png" Width="30" DockPanel.Dock="Left"/>
            <Label Content="Комнаты - вход"/>
            <Button Content="  X  " Background="Red" Click="Button_Click_Close" DockPanel.Dock="Right"/>
            <Button Content=" [ ] " Click="Button_Click_Size" Visibility="Collapsed" DockPanel.Dock="Right"/>
            <Button Content="  -  " Click="Button_Click_Hidden" DockPanel.Dock="Right"/>
            <Grid/>
        </DockPanel>
        <StackPanel Width="200">
            <Label Content="Авторизация"/>
            <TextBlock Text="Логин"/>
            <TextBox x:Name="login" TextChanged="login_TextChanged">
                <TextBox.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="FontSize"
                                    To="30" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="FontSize"
                                    To="15" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBox.Triggers>
            </TextBox>
            <TextBlock Text="Пароль" Margin="0 20 0 5"/>
            <PasswordBox x:Name="password" FontSize="15" PasswordChanged="password_PasswordChanged"/>
            <Button Content="Войти" Width="100" Margin="20" x:Name="buttonLogin" Click="buttonLogin_Click" IsEnabled="False" FontSize="15">
                <Button.Triggers>
                    <Trigger Property="IsEnabled" Value="True">
                        <Setter Property="Background" Value="Green"/>
                    </Trigger>
                </Button.Triggers>
            </Button>
            <Button Content="забыл пароль" Background="Transparent" BorderBrush="Transparent" Foreground="Blue">
                <Button.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <ThicknessAnimation
                                    Storyboard.TargetProperty="Margin"
                                    To="0 50 0 0" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <ThicknessAnimation
                                    Storyboard.TargetProperty="Margin"
                                    To="0 0 0 0" Duration="0:0:5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>
        </StackPanel>
    </DockPanel>
</Window>
