<Window x:Class="Билет0_Попытка_1.WindowRegistration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Билет0_Попытка_1"
        mc:Ignorable="d"
        Style="{StaticResource styleWindow}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="100"
                      CornerRadius="20"
                      />
    </WindowChrome.WindowChrome>

    <DockPanel>
        <Label DockPanel.Dock="Top" Background="AliceBlue" Height="100" Content="Тренировки - Регистрация" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <Grid>
            <UniformGrid Rows="4" Columns="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Логин" x:Name="textBlockLogin"/>
                <TextBox x:Name="textBoxLogin"/>
                <TextBlock x:Name="textBlockPassword" Text="Пароль"/>
                <TextBox x:Name="textBoxPassword"/>
                <TextBlock x:Name="textBlockConfirmPassword" Text="Повторите пароль"/>
                <TextBox x:Name="textBoxConfirmPassword"/>
                <TextBlock x:Name="textBlockPhone" Text="Телефон"/>
                <TextBox x:Name="textBoxPhone"/>
                <Button Content="Авторизоваться" Click="Button_Click_OpenWindowAuth"/>
                <Button Content="Зарегистрироваться" Click="Button_Click_Registration"/>
            </UniformGrid>
        </Grid>
    </DockPanel>
    
</Window>
