<Window x:Class="Билет0_Попытка_1.WindowAuth"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Билет0_Попытка_1"
        mc:Ignorable="d"
        Title="WindowAuth" Height="300" Width="400">
    <Grid>
        <UniformGrid Rows="3" Columns="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Логин"/>
            <TextBox x:Name="textBoxLogin"/>
            <TextBlock Text="Пароль"/>
            <TextBox x:Name="textBoxPassword"/>
            <Button Content="Зарегистрироваться" Click="Button_Click_OpenWindowReg"/>
            <Button Content="Авторизоваться"/>
        </UniformGrid>
    </Grid>
</Window>
