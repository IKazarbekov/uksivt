<Window x:Class="Попытка3_в_кабинете.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Попытка3_в_кабинете"
        mc:Ignorable="d"
        Title="Тренировка - авторизация" Height="250" Width="500">
    <StackPanel>
        <Label Content="Авторизация"/>
        <TextBlock Text="Login"/>
        <TextBox x:Name="textBox_login"/>
        <TextBlock Text="Password"/>
        <TextBox x:Name="textBox_password"/>
        <Button Content="Войти" Click="ButtonLogin_Click"/>
        <Button Content="Test Admin" Click="ButtonTestAdmin_Click"/>
    </StackPanel>
</Window>
