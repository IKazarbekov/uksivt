<Window x:Class="Попытка_13.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Попытка_13"
        mc:Ignorable="d"
        Title="Клиент" Height="450" Width="800" WindowStyle="None" MouseDown="Window_MouseDown">
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" HorizontalAlignment="Right">
            <Button Content=" Выйти " Click="Button_Click_Exit" Background="Orange"/>
            <Button Content="  -  " Click="Button_Click_Size"/>
            <Button Content=" [ ] " Click="Button_Click_Size"/>
            <Button Content="  X  " Click="Button_Click_Close" Background="Red"/>
        </StackPanel>
        <StackPanel x:Name="stacked">

        </StackPanel>
    </DockPanel>
</Window>
