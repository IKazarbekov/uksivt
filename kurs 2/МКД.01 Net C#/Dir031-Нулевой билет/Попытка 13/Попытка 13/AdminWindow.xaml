<Window x:Class="Попытка_13.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Попытка_13"
        mc:Ignorable="d"
        Title="Админ панель" MinHeight="700" MinWidth="700" WindowStyle="None" MouseDown="Window_MouseDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CornerRadius="10"
                      ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>
        <TabControl>
            <TabItem Header="Тренировки">
                <DockPanel>
                    <WrapPanel Orientation="Horizontal" DockPanel.Dock="Bottom">
                    <TextBlock Text="Добавление Тренировки">
                    </TextBlock>
                        <TextBlock>Треннер</TextBlock>
                        <TextBox x:Name="trenner" Width="100" TextChanged="trenner_TextChanged"/>
                        <TextBlock>Тип</TextBlock>
                        <TextBox x:Name="type" Width="100" TextChanged="trenner_TextChanged"/>
                        <TextBlock>Кол-во мест</TextBlock>
                        <TextBox  TextChanged="trenner_TextChanged" x:Name="count" Width="100"/>
                        <DatePicker x:Name="date" SelectedDateChanged="date_SelectedDateChanged"/>
                        <Button IsEnabled="False" x:Name="buttonLesson" Content="Добавить" Click="Button_Click_LessonAdd"/>
                    </WrapPanel>
                    <DataGrid x:Name="lessons">
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Бронирование">
                <StackPanel>
                    <DataGrid x:Name="lessonsForBrone" SelectedCellsChanged="lessonsForBrone_SelectedCellsChanged"/>
                    <DataGrid x:Name="users" SelectedCellsChanged="lessonsForBrone_SelectedCellsChanged"/>
                    <Button IsEnabled="False" x:Name="buttonBrone" Content="Добавить бронирование" Click="Button_Click_BroneAdd"/>
                    <DataGrid x:Name="brones"/>
                </StackPanel>
            </TabItem>

            <TabItem HorizontalAlignment="Right">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Выйти" Click="Button_Click" Background="Orange"/>
                        <Button Content="  -  " Click="Button_Click_See"/>
                        <Button Content=" [ ] " Click="Button_Click_Size"/>
                        <Button Content="  X  " Click="Button_Click_Close" Background="Red"/>
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
        </TabControl>

</Window>
