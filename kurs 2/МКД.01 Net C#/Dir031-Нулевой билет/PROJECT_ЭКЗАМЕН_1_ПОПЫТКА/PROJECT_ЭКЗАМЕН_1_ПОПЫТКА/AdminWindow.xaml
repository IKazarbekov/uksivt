<Window x:Class="PROJECT_ЭКЗАМЕН_1_ПОПЫТКА.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PROJECT_ЭКЗАМЕН_1_ПОПЫТКА"
        mc:Ignorable="d"
        Title="AdminWindow" Height="450" Width="800" Closing="Window_Closing">
    <Grid>
        <TabControl>
            <TabItem Header="Пользователи">
                <DataGrid x:Name="viewUser">

                </DataGrid>
            </TabItem>
            <TabItem Header="Тренировки">
                <DockPanel>
                    <UniformGrid Columns="6" Rows="2" DockPanel.Dock="Bottom">
                        <TextBlock Text="Кол-во мест"/>
                        <TextBox x:Name="textBoxCountSpace"/>
                        <TextBlock Text="Тренер"/>
                        <TextBox x:Name="textBoxTranner"/>
                        <DatePicker x:Name="datePicker"/>
                        <Button Content="Добавить" Click="Button_Click"/>
                        <Button Content="Удалить" Click="Button_Click_1"/>
                        <Separator Visibility="Hidden"/>
                        <DatePicker x:Name="datePickerBrone"/>
                        <CheckBox Content="Прянять" x:Name="checkBox"/>
                        <Button Content="Забронировать" Click="Button_Click_2"/>
                    </UniformGrid>
                    <DataGrid x:Name="viewLesson" CanUserAddRows="False">
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Брони">
                <DataGrid x:Name="viewBrone">

                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
