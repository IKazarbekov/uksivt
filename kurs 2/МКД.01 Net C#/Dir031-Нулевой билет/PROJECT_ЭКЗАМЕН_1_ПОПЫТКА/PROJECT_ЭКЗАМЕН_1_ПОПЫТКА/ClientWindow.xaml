<Window x:Class="PROJECT_ЭКЗАМЕН_1_ПОПЫТКА.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PROJECT_ЭКЗАМЕН_1_ПОПЫТКА"
        mc:Ignorable="d"
        Title="ClientWindow" Height="450" Width="800" Closed="Window_Closed">
    <DockPanel>
        <Button Content="Выйти" Click="Button_Click" DockPanel.Dock="Top" HorizontalAlignment="Right"/>
        <ListView ItemsSource="{Binding}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TypeStr}" Grid.Column="0"/>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding TrennerStr}"/>
                            <TextBlock Text="{Binding DateStr}"/>
                            <TextBlock Text="{Binding BroneStr}"/>
                        </StackPanel>
                        <CheckBox Content="Принять" IsChecked="{Binding StatusChk}"/>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</Window>
