<Window x:Class="NewBilet.RegWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewBilet"
        mc:Ignorable="d"
        Title="RegWindow" Height="450" Width="800">
    <StackPanel>
        <Label Content="Вход в аккаунт"/>
        <TextBlock Text="Логин"/>
        <TextBox x:Name="login"/>
        <TextBlock Text="Пароль"/>
        <TextBox x:Name="password"/>
        <TextBlock Text="Номер телефона"/>
        <TextBox x:Name="number"/>
        <Button x:Name="log" Click="log_Click" Content="Войти" Width="150"/>
        <Separator Height="30" Width="150"/>
        <Button x:Name="reg" Click="reg_Click" Content="Зарегистрироваться" Width="250"/>
    </StackPanel>
</Window>
