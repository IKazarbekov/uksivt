<Window x:Class="на_сдачу_учебной_пратикик.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:на_сдачу_учебной_пратикик"
        mc:Ignorable="d"
        Title="Просмотри броней" Height="300" Width="700" MinHeight="300" MinWidth="700" AllowsTransparency="False" WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CornerRadius="10"
                      ResizeBorderThickness="20"
                      CaptionHeight="30"/>
    </WindowChrome.WindowChrome>
    <Viewbox>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <Label Content="Ваши брони на тренировки" DockPanel.Dock="Left"/>
                <Button Content="Выйти" DockPanel.Dock="Right" Click="Button_Click"/>
                <Grid/>
            </DockPanel>
            <ListBox ItemsSource="{Binding}" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Label Content="{Binding Type}" DockPanel.Dock="Left"/>
                            <Label Content="{Binding Status}" DockPanel.Dock="Right"/>
                            <StackPanel>
                                <Label Content="{Binding Trenner}"/>
                                <TextBlock Text="{Binding DateLesson}"/>
                                <TextBlock Text="{Binding Date}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Viewbox>
</Window>
